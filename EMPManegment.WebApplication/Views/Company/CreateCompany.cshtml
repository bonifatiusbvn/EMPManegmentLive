@model EMPManegment.EntityModels.ViewModels.Company.CompanyModel
@using EMPManegment.Web.Models
@inject IHttpContextAccessor Accessor;
@inject UserSession _userSession

@{
    ViewData["Title"] = "CreateCompany";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
    var imageUrl = Model != null && !string.IsNullOrEmpty(Model.CompanyLogo) ? Url.Content($"~/{Model.CompanyLogo}") : null;
    var Companyinitials = Model != null && !string.IsNullOrEmpty(Model.CompnyName)
                   ? $"{Model.CompnyName[0]}".ToUpper()
                   : string.Empty;
}
<style>


    #imagePreview img {
        max-width: 150px;
        height: auto;
        border-radius: 10px;
        margin-top: 15px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    }

    .logo-preview {
        max-width: 150px;
        height: auto;
        border-radius: 10px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    }


    .required-field::after {
        content: " *";
        color: #dc3545;
    }

    @@media (max-width: 900px) {
        .create-company-container {
            padding: 15px;
        }

        .company-button {
            width: 100%;
            margin-top: 15px;
        }
    }
</style>

<!-- start page title -->
<div class="row" style="margin-top:80px;">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between content-header">
            <h4 class="fm-header mb-sm-0">Create Company</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Company</a></li>
                    <li class="breadcrumb-item active">Create Company</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- end page title -->
<div class="fm-container">

    <!-- Company Form -->
    <form id="createCompanyform" autocomplete="off">
        <input type="hidden" id="txtcompanyId" value="@Model.Id">
        <input type="hidden" id="txtCompanyUpdatedby" value="@_userSession.UserId">

        <div class="card fm-card">
            <div class="card-header fm-card-header">
                Business Details
            </div>

            <div class="card-body">
                <div class="row">
                    <!-- Company Name -->
                    <div class="col-md-6 mb-3">
                        <label for="txtcompanyname" class="form-label required-field">Company Name</label>
                        <input type="text" class="form-control" id="txtcompanyname"
                               value="@Model.CompnyName" placeholder="Enter company name" required>
                    </div>

                    <!-- Email -->
                    <div class="col-md-6 mb-3">
                        <label for="txtcompanyemail" class="form-label required-field">Email</label>
                        <input type="email" class="form-control" id="txtcompanyemail"
                               value="@Model.Email" placeholder="Enter company email" required>
                    </div>

                    <!-- Contact Number -->
                    <div class="col-md-6 mb-3">
                        <label for="txtcompanycontactnumber" class="form-label required-field">Contact Number</label>
                        <input type="text" class="form-control" id="txtcompanycontactnumber"
                               value="@Model.ContactNumber" placeholder="Enter contact number" required>
                    </div>

                    <!-- GST -->
                    <div class="col-md-6 mb-3">
                        <label for="txtcompanygst" class="form-label">GST Number</label>
                        <input type="text" class="form-control" id="txtcompanygst"
                               value="@Model.Gst" placeholder="Enter GST number">
                    </div>

                    <!-- Country -->
                    <div class="col-md-3 mb-3">
                        <label for="CompanyCountry" class="form-label required-field">Country</label>
                        <select id="CompanyCountry" class="form-control select2 select2-teal"
                                data-dropdown-css-class="select2-teal"
                                onchange="fn_getCompanyState('CompanyState',null,this)" required>
                            @if (Model.CountryName != null)
                            {
                                <option value="@Model.Country" selected>@Model.CountryName</option>
                            }
                        </select>
                    </div>

                    <!-- State -->
                    <div class="col-md-3 mb-3">
                        <label for="CompanyState" class="form-label required-field">State</label>
                        <select id="CompanyState" class="form-control select2 select2-teal"
                                data-dropdown-css-class="select2-teal"
                                onchange="fn_getCompanycitiesbystateId('CompanyCity', null, this)" required>
                            @if (Model.StateName != null)
                            {
                                <option value="@Model.State" selected>@Model.StateName</option>
                            }
                        </select>
                    </div>

                    <!-- City -->
                    <div class="col-md-3 mb-3">
                        <label for="CompanyCity" class="form-label required-field">City</label>
                        <select id="CompanyCity" class="form-control select2 select2-teal"
                                data-dropdown-css-class="select2-teal" required>
                            @if (Model.CityName != null)
                            {
                                <option value="@Model.City" selected>@Model.CityName</option>
                            }
                        </select>
                    </div>

                    <!-- Pincode -->
                    <div class="col-md-3 mb-3">
                        <label for="txtPincode" class="form-label required-field">PinCode</label>
                        <input type="number" class="form-control" id="txtPincode"
                               value="@Model.PinCode" placeholder="Enter pincode" required>
                    </div>

                    <!-- Address -->
                    <div class="col-12 mb-3">
                        <label for="txtCompanyAddress" class="form-label required-field">Address</label>
                        <textarea class="form-control" id="txtCompanyAddress" rows="3"
                                  placeholder="Enter company address" required>@Model.Address</textarea>
                    </div>

                    <!-- Logo Upload -->
                    <div class="col-12 mb-3">
                        <label class="form-label">Company Logo</label>
                        <div class="dropzone-area" id="dropzone">
                            <label for="fileUpload" class="dz-message">
                                <div class="dz-icon">
                                    <i class="ri-upload-cloud-2-fill"></i>
                                </div>
                                <div class="dz-text">
                                    <h5>Click to upload or drop an image here</h5>
                                    <p>(Only image files are accepted)</p>
                                </div>
                            </label>
                            <input type="file" accept="image/*" class="form-control d-none" id="fileUpload" name="CompanyLogo" />

                            <!-- Logo Preview on Load -->
                            <div id="imagePreview" class="mt-3 text-center">
                                @if (!string.IsNullOrEmpty(Model.CompanyLogo))
                                {
                                    <div class="d-inline-block position-relative">
                                        <img src="~/Content/Image/@Model.CompanyLogo" alt="Company Logo" class="logo-preview" id="existingLogo" />
                                        <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 remove-logo" onclick="removeExistingLogo()">×</button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    <span id="currentCompanyImageName" class="d-none">@Model.CompanyLogo</span>
                    <input type="hidden" name="IsLogoRemoved" id="IsLogoRemoved" value="false" />

                    @*                     <div class="col-12 mb-3">
                        <label class="form-label">Company Logo</label>
                        <div class="dropzone-area" id="dropzone">
                            <div class="dz-message">
                                <i class="ri-upload-cloud-2-fill display-4 text-teal"></i>
                                <h5 class="mt-3">Drop files here or click to upload</h5>
                                <p class="text-muted">(Only image files are accepted)</p>
                            </div>
                        </div>

                        <!-- Logo Preview -->
                        <div class="mt-3" id="logo-preview-container">
                            @if (!string.IsNullOrEmpty(Model.CompanyLogo))
                            {
                                <div class="d-flex align-items-center">
                                    <img src="~/Content/Image/@Model.CompanyLogo" class="logo-preview me-3">
                                    <button class="btn btn-sm btn-danger remove-logo">Remove Logo</button>
                                </div>
                            }
                        </div>
                    </div> *@
                </div>

                <!-- Form Actions -->
                <div class="text-end mt-4">
                    @if (Model.Id == null || Model.Id == Guid.Empty)
                    {
                        <button type="button" class="btn button-teal"
                                onclick="AddCompanyDetails()" id="SubmitCompanyDetails">
                            <i class="ri-save-line me-1"></i> Create
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn button-teal"
                                onclick="UpdateCompanyDetails('@Model.Id')" id="updateCompanybtn">
                            <i class="ri-edit-line me-1"></i> Update
                        </button>
                    }
                </div>
            </div>
        </div>
    </form>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script type="text/javascript">
    var userPermissions = '@Html.Raw(Json.Serialize(UserSession.FormPermisionData))';


        $(document).ready(function () {
        let countryId = $('#CompanyCountry').val();
        let stateId = '@Model.State';
        let cityId = '@Model.City';

        if (countryId) {
            fn_getCompanyState('CompanyState', countryId, null, function () {
                if (stateId) {
                    $('#CompanyState').val(stateId).trigger('change');

                    fn_getCompanycitiesbystateId('CompanyCity', stateId, null, function () {
                        if (cityId) {
                            $('#CompanyCity').val(cityId).trigger('change');
                        }
                    });
                }
            });
        }
    });


    $(document).ready(function () {

        if ($("#textViewMode").val() === "True") {
            document.querySelectorAll('#createCompanyform input, #createCompanyform select, #createCompanyform textarea').forEach(function (element) {
                element.disabled = true;
            });
            $("#createCompanyform button").hide();
            $("#editCompanybtn").show();
        }
        else {
            document.querySelectorAll('#createCompanyform input, #createCompanyform select, #createCompanyform textarea').forEach(function (element) {
                element.disabled = false;
            });
        }
    });

    document.getElementById('dropzone').addEventListener('click', function () {
        document.getElementById('fileUpload').click();
    });

        document.getElementById('fileUpload').addEventListener('change', function (e) {
        const file = e.target.files[0];
        const preview = document.getElementById('imagePreview');
        preview.innerHTML = ''; // Clear any previous image/logo

        if (file && file.type.startsWith('image/')) {
            const reader = new FileReader();
            reader.onload = function (e) {
                const img = document.createElement('img');
                img.src = e.target.result;
                img.alt = "Selected Image";
                img.className = "logo-preview";
                preview.appendChild(img);
            };
            reader.readAsDataURL(file);
        } else {
            preview.innerHTML = '<p class="text-danger">Please select a valid image file.</p>';
        }
    });

    function removeExistingLogo() {
        document.getElementById('imagePreview').innerHTML = '<p class="text-muted">Logo removed. You can upload a new one.</p>';
        document.getElementById('IsLogoRemoved').value = 'true'; // signal to remove on server
    }

</script>

<script src="~/moduls/companyscript.js" asp-append-version="true"></script>
