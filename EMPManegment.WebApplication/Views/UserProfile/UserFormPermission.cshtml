@using EMPManegment.Web.Models;
@inject IHttpContextAccessor Accessor;
@inject UserSession _userSession
@{
    ViewData["Title"] = "UserFormPermission";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

<div class="row" style="margin-top:80px;">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between content-header">
            <h4 class="fm-header mb-sm-0">User Form Permission</h4>

            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">User</a></li>
                    <li class="breadcrumb-item active">User Form Permission</li>
                </ol>
            </div>

        </div>
    </div>
</div>
<!-- end page title -->
<div id="createUserModal" class="modal fade flip" tabindex="-1" role="dialog" aria-labelledby="createUserModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="addUserForm">
                <div class="modal-header bg-primary-subtle p-3">
                    <h5 class="modal-title" id="createUserModalLabel">User Form Permission</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="hstack gap-3 align-items-start">
                        <div class="flex-grow-1">
                            <label for="drpAttusername" class="form-label">User <span class="text-danger">*</span></label>
                            <input type="text" value="@_userSession.UserId" id="textuserId" hidden />
                            <select class="form-control from-select" id="drpAttusername" name="drpAttusername">
                                <option value="">---Select Username---</option>
                            </select>
                            <input type="text" class="form-control" id="textUserIdfrm" name="textUserIdfrm" hidden />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-success" onclick="validateAndCreateUser()">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="col-lg-12">
    <div class="card">
        <div class="card-header">
            <div class="row align-items-center">
                <div class="col-12 col-md-6 col-lg-4 mb-2 mb-md-0">
                    <select class="form-control select2 select2-teal"
                            data-dropdown-css-class="select2-teal"
                            id="usercustomDropdown"
                            name="usercustomDropdown">
                    </select>
                </div>

                @if (UserSession.FormPermisionData.Any(a => a.FormName == "User Form Permission" && a.Add ))
                {
                    <div class="col-12 col-md-6 col-lg-8 text-md-end mt-2 mt-md-0">
                        <button type="button" class="btn button-teal btn-md" data-bs-toggle="modal" data-bs-target="#createUserModal" onclick="clearTextUserName()" style="margin-top:0px;"><i class="fa-solid fa-circle-plus me-1"></i>UserPermission</button>
                    </div>
                }
            </div>
        </div>
        <div class="card-body">
            <div id="UserPermissionTable" class="ag-theme-teal" style="height: 540px; width: 100%;"></div>
        </div>
        <div class="card-footer">
            <div class="text-end" id="userupdatebtn" style="display:none;">
                <button type="button" class="btn button-teal" onclick="UpdateUserFormPermission()"> <i class="ri-edit-line me-1"></i> Update</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    window.userFormPermissions = @Html.Raw(Json.Serialize(UserSession.FormPermisionData));
</script>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/moduls/FormPermissionScript.js" asp-append-version="true"></script>



