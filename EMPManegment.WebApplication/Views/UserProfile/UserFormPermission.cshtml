@using EMPManegment.Web.Models;
@inject IHttpContextAccessor Accessor;
@inject UserSession _userSession
@{
    ViewData["Title"] = "UserFormPermission";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

<div class="row" style="margin-top:80px;">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between content-header">
            <h4 class="fm-header mb-sm-0">User Form Permission</h4>

            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">User</a></li>
                    <li class="breadcrumb-item active">User Form Permission</li>
                </ol>
            </div>

        </div>
    </div>
</div>
<!-- end page title -->
<div id="createRoleModal" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="addUserRole">

                <div class="modal-header bg-teal text-white p-3">
                    <h5 class="modal-title">Create Role</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label for="textRoleName" class="form-label">Role Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="textRoleName" placeholder="Enter role name" required>
                        <input type="hidden" id="txtUserId" value="@_userSession.UserId">
                        <input type="hidden" id="textRoleId">
                    </div>
                </div>

                <div class="modal-footer p-3">
                    <button type="button" class="btn button-cls" data-bs-dismiss="modal">Close</button>
                    <button type="button" class="btn btn-teal" onclick="validateAndCreateRole()">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="col-lg-12">
    <div class="card">
        <div class="card-header">
            <div class="row align-items-center">
                <div class="col-12 col-md-6 col-lg-4 mb-2 mb-md-0">
                    <select class="form-control select2 select2-teal"
                            data-dropdown-css-class="select2-teal"
                            id="ddlUserRole"
                            name="ddlUserRole">
                    </select>
                </div>

                @if (UserSession.FormPermisionData.Any(a => a.FormName == "Company List" && a.Add))
                {
                    <div class="col-12 col-md-6 col-lg-8 text-md-end mt-2 mt-md-0">
                        <button type="button" class="btn button-teal btn-md" data-bs-toggle="modal" data-bs-target="#createUserModal" onclick="clearTextUserName()" style="margin-top:0px;"><i class="ri-add-line align-bottom me-1"></i>UserPermission</button>
                    </div>
                }
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive" style="position: relative; height: 600px; overflow: auto;">
                <table class="table fixed-header-table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Form Name</th>
                            <th>Add</th>
                            <th>View</th>
                            <th>Edit</th>
                            <th>Delete</th>
                            <th>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="userCheckboxAll" onclick="userAllCheckboxes(this)">
                                </div>
                            </th>
                        </tr>
                    </thead>
                    <tbody id="dveditUserForm" class="gridjs-tbody">
                    </tbody>
                </table>
                <div class="text-end" id="userupdatebtn" style="display:none;">
                    <button type="button" class="btn button-teal" onclick="UpdateUserFormPermission()" style="width: 160px;height: 50px;">Update</button>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        var allCheckbox = document.getElementById('userCheckboxAll');
        var checkboxes = document.querySelectorAll('.form-check-input-all, .user-checkbox');
        allCheckbox.checked = Array.from(checkboxes).every(function (checkbox) {
            return checkbox.checked;
        });
    });
</script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/moduls/FormPermissionScript.js" asp-append-version="true"></script>



