@using EMPManegment.Web.Models
@inject IHttpContextAccessor Accessor;
@inject UserSession _userSession

@{
    ViewData["Title"] = "MyAttendance";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

<style>
    @@media (max-width: 600px) {
        .card-header .d-flex {
            flex-direction: column;
        }

        .btn-group {
            width: 100%;
        }

        #monthbox, #datebox, #datebox1, #myattendanceseachbtn {
            display: block;
            width: 100%;
            margin-top: 10px;
        }

        .search-box {
            width: 100%;
        }

        #attendancepdfexcel {
            display: flex;
            flex-direction: column;
            width: 100%;
            margin-top: 10px;
        }

            #attendancepdfexcel a {
                width: 100%;
                margin-top: 5px;
            }
    }
</style>

<!-- start page title -->
<div class="row" style="margin-top:80px;">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between content-header">
            <h4 class="fm-header mb-sm-0">My Attendance</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Attendance</a></li>
                    <li class="breadcrumb-item active">My Attendance</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- end page title -->
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col-12 col-lg-3">
                        <input class="form-control"
                               id="txtMyAttendanceSearch"
                               placeholder="Search..." />
                    </div>
                    <div class="col-12 col-lg-auto">
                        <div class="d-flex">
                            <button class="btn button-teal px-3" id="AttendanceMonthFiltertoggle" title="Filter by Month">
                                <i class="fa fa-calendar me-1" aria-hidden="true"></i>  <span class="d-none d-sm-inline">Month</span>
                            </button>
                            <div id="AttendanceMonthFilterContainer" class="date-filter-container"
                                 style="display: none; position: absolute; z-index: 1000; background: white;">
                                <div class="p-3 bg-light border">
                                    <label for="txtmonth" class="d-block mb-2">Month</label>
                                    <input type="month" id="txtmonth" class="form-control mb-3" style="font-size: 15px;">
                                    <button class="btn button-teal btn-block" id="applyMonthAttendanceFilter">Apply</button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-1">
                        <button class="btn button-teal" id="toggleDateFilter">
                            <i class="fa fa-calendar" aria-hidden="true"></i><span class="d-none d-sm-inline" style="margin-left: 10px;">Date</span>
                        </button>
                        <div id="dateFilterContainer" class="date-filter-container" style="display: none;">
                            <div class="p-2 bg-light border">
                                <label for="txtstartdatebox">From Date</label>
                                <input type="date" id="txtstartdatebox" class="form-control mb-3 datepicker" style="font-size: 15px;">
                                <label for="txtenddatebox">To Date</label>
                                <input type="date" id="txtenddatebox" class="form-control mb-3 datepicker" style="font-size: 15px;">
                                <button class="btn button-teal btn-block" id="applyFilters">Apply</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-2">
                        <button class="btn btn-secondary" style="margin-left: -30px;" onclick="ResetMyAttendanceData()"> Reset</button>
                    </div>

                </div>
            </div>
            <div class="card-body">
                <div id="MyAttendanceTable" class="ag-theme-teal" style="height: 600px; width: 100%;"></div>
            </div>

            <div class="card-body">
                <!--Partail View-->
                <div id="GetMyAttendanceList"></div>
            </div>
            <div class="modal fade" id="editMyAttendanceTime" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header bg-light p-3">
                            <h5 class="modal-title" id="exampleModalLabel">Edit My Attendance</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="close-modal"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-3">
                                <label for="customername-field" class="form-label" hidden>AttandanceId</label>
                                <input id="txtmyAttandanceId" class="form-control" hidden />
                                <input id="UserId" class="form-control" hidden />
                            </div>
                            <div class="mb-3">
                                <label for="customername-field" class="form-label">UserName</label>
                                <input id="txtmyUserName" class="form-control" disabled />
                            </div>
                            <div class="mb-3">
                                <label for="email-field" class="form-label">Date</label>
                                <input id="txtmyDate" class="form-control" disabled />
                            </div>
                            <div class="mb-3">
                                <label for="phone-field" class="form-label">Intime</label>
                                <input type="datetime-local" id="txtmyIntime" class="form-control" />
                            </div>
                            <div class="mb-3">
                                <label for="date-field" class="form-label">OutTime</label>
                                <input type="datetime-local" id="txtmyOutTime" class="form-control" />
                            </div>
                        </div>
                        <div class="modal-footer">
                            <div class="hstack gap-2 justify-content-end">
                                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Close</button>
                                <button type="submit" class="btn btn-success" onclick="updateMyAttendance()" id="SubmitButton">Update Time</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var userPermissions = '@Html.Raw(Json.Serialize(UserSession.FormPermisionData))';
    var today = new Date();
    var month = today.getMonth() + 1;
    var year = today.getFullYear();

    if (month < 10) {
        month = '0' + month;
    }

    var maxMonth = year + '-' + month;

    var maxDate = today.toISOString().split('T')[0];

    document.getElementById("txtmonth").setAttribute("max", maxMonth);
    document.getElementById("txtstartdate").setAttribute("max", maxDate);
    document.getElementById("txtenddate").setAttribute("max", maxDate);

    var userPermissions = '@Html.Raw(Json.Serialize(UserSession.FormPermisionData))';
</script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/moduls/userattendancescript.js" asp-append-version="true"></script>


