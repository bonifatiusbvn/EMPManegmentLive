@using EMPManegment.Web.Models;
@inject IHttpContextAccessor Accessor;
@inject UserSession _userSession;
@{
    ViewData["Title"] = "GetAllUsersAttendanceList";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}
<style>

    @@media (max-width: 600px) {
        .card-header .d-flex {
            flex-direction: column;
        }

        .card-header .row {
            flex-direction: column;
            align-items: flex-start;
        }

        .card-header .col-sm,
        .card-header .col-lg-auto {
            width: 100%;
            margin-bottom: 10px;
        }

        .card-header .btn-group {
            width: 100%;
            margin-bottom: 10px;
        }

        #searchUserAttendancebtn {
            display: block;
            width: 100%;
        }
    }
</style>
<!-- start page title -->
<div class="row" style="margin-top:80px;">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between content-header">
            <h4 class="fm-header mb-sm-0">All User Attendance</h4>

            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">User</a></li>
                    <li class="breadcrumb-item active">All User Attendance</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- end page title -->

<div class="card">
    <input type="text" id="textUpdatedById" class="form-control" hidden value="@_userSession.UserId" />
    <div class="card-header">
        <div class="row align-items-center">
            <div class="col-12 col-lg-3">
                <input class="form-control"
                       id="txtAllUserAttendanceSearch"
                       placeholder="Search..." />
            </div>
            <div class="col-12 col-lg-2">
                <select class="form-control select2 select2-teal"
                        data-dropdown-css-class="select2-teal"
                        id="drpAttusername">
                </select>
                <input type="hidden" id="txtUserName" />
            </div>
            <div class="col-12 col-lg-1">
                <button class="btn button-teal" id="toggleDateFilter">
                    <i class="fa fa-calendar" aria-hidden="true"></i><span class="d-none d-sm-inline" style="margin-left: 10px;">Date</span>
                </button>
                <div id="dateFilterContainer" class="date-filter-container" style="display: none;">
                    <div class="p-2 bg-light border">
                        <label for="txtstartdatebox">From Date</label>
                        <input type="date" id="txtstartdatebox" class="form-control mb-3" style="font-size: 15px;">
                        <label for="txtenddatebox">To Date</label>
                        <input type="date" id="txtenddatebox" class="form-control mb-3" style="font-size: 15px;">
                        <button class="btn button-teal btn-block" id="applyFilters">Apply</button>
                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-2">
                <button class="btn button-rest" style="margin-left: -30px;" onclick="ResetAllUserAttendanceData()"> Reset</button>
            </div>
            <div class="col-12 col-lg-4" style="text-align:end">
                <button class="btn button-teal" onclick="DisplayAddUserModel()"><i class="fa-solid fa-circle-plus"></i> Attendance</button>
            </div>

        </div>
    </div>

    <div class="card-body">
        <div id="AllUserAttendanceTable" class="ag-theme-teal" style="height: 600px; width: 100%;"></div>
    </div>

    <div class="modal fade" id="EditTimeModel" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content fm-form">
                <div class="modal-header bg-teal p-3">
                    <h5 class="modal-title" id="exampleModalLabel" style="color:white">Update User Attendance</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="close-modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="customername-field" class="form-label" hidden>AttandanceId</label>
                        <input id="AttandanceId" class="form-control" hidden />
                        <input id="UserId" class="form-control" hidden />
                    </div>

                    <div class="mb-3">
                        <label for="customername-field" class="form-label">UserName</label>
                        <input id="UserName" class="form-control" disabled />
                    </div>

                    <div class="mb-3">
                        <label for="email-field" class="form-label">Date</label>
                        <input id="Date" class="form-control" disabled />
                    </div>

                    <div class="mb-3">
                        <label for="phone-field" class="form-label">Intime</label>
                        <input type="datetime-local" id="Intime" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label for="date-field" class="form-label">OutTime</label>
                        <input type="datetime-local" id="OutTime" class="form-control" />
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="hstack gap-2 justify-content-end">
                        <button type="button" class="btn btn-secondary btn-default m-1" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn button-teal" onclick="updateUserAttendance();"><i class="ri-edit-line me-1"></i> Update</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Modal -->
    <div class="modal fade" id="AddUserAttendanceModel" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content fm-form">
                <div class="modal-header bg-teal p-3">
                    <h5 class="modal-title" id="exampleModalLabel" style="color:white">Add User Attendance</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="frmadduserdetails">
                        <div class="mb-3">
                            <label for="customername-field" class="form-label" hidden>AttandanceId</label>
                            <input id="txtattandanceId" class="form-control" hidden />
                            <input id="txtuserId" class="form-control" hidden />
                        </div>

                        <div class="mb-3">
                            <label for="customername-field" class="form-label">UserName<span class="text-danger">*</span></label>
                            <select class="form-control select2 select2-teal"
                                    data-dropdown-css-class="select2-teal" id="ddlusername" name="ddlusername">
                            </select>
                            <input type="hidden" id="txtuserName" class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label for="email-field" class="form-label">Date<span class="text-danger">*</span></label>
                            <input type="date" id="txtDate" name="txtDate" class="form-control material_blue" />
                        </div>

                        <div class="mb-3">
                            <label for="phone-field" class="form-label">Intime<span class="text-danger">*</span></label>
                            <input type="datetime-local" id="txtIntime" name="txtIntime" class="form-control material_blue" />
                        </div>

                        <div class="mb-3">
                            <label for="date-field" class="form-label">OutTime</label>
                            <input type="datetime-local" id="txtOutTime" class="form-control material_blue" />
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <div class="hstack gap-2 justify-content-end">
                        <button type="button" class="btn btn-secondary btn-default m-1" data-bs-dismiss="modal">Close</button>
                        <button type="submit" class="btn button-teal" onclick="btnSaveUserAttendance();" id="userDetails" value="Validate"><i class="ri-save-line me-1"></i> Save</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!--end modal-->
    <!---End of DataTable-->
    <div class="card-body">
        <!--Partail View-->
        <div id="dvattendancelist"></div>
    </div>
    <h4 class="fs-22 fw-semibold ff-secondary mb-4">
        <span class="text-danger" id="errorMessage"></span>
    </h4>
</div>

<script type="text/javascript">

     window.userFormPermissions = @Html.Raw(Json.Serialize(UserSession.FormPermisionData));

    var today = new Date();
    var month = today.getMonth() + 1;
    var year = today.getFullYear();

    if (month < 10) {
        month = '0' + month;
    }

    var maxDate = today.toISOString().split('T')[0];

    document.getElementById("txtstartdatebox").setAttribute("max", maxDate);
    document.getElementById("txtenddatebox").setAttribute("max", maxDate);
    document.getElementById("txtdate").setAttribute("max", maxDate);


    window.onload = function () {
        var today = new Date().toISOString().split('T')[0];
        document.getElementById('txtDate').value = today;
    };

</script>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/moduls/userattendancescript.js" asp-append-version="true"></script>




