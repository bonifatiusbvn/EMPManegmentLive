@using EMPManegment.Web.Models;
@inject IHttpContextAccessor Accessor;
@inject UserSession _userSession

@model EMPManegment.EntityModels.View_Model.LoginDetailsView
@{
    ViewData["Title"] = "RolewisePermission";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}
<style>

    #imagePreview img {
        max-width: 150px;
        height: auto;
        border-radius: 10px;
        margin-top: 15px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    }

</style>

<div class="row" style="margin-top:80px;">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between content-header">
            <h4 class="fm-header mb-sm-0">Create User</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">User</a></li>
                    <li class="breadcrumb-item active">Create User</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<!-- auth page content -->

<div class="fm-container">

    <!-- User Form -->
    <form id="CreateUserForm" method="post" enctype="multipart/form-data">
        <div class="card fm-card">
            <div class="card-header fm-card-header">
                User Details
            </div>

            <div class="card-body">
                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label for="EmpId" class="form-label">Employee Id</label>
                        <input type="text" readonly id="EmpId" autocomplete="off" class="form-control" value="@ViewBag.EmpId" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="drpCuDepartment" class="form-label required-field">Department </label>
                        <select class="form-control select2 select2-teal"
                                data-dropdown-css-class="select2-teal"
                                id="drpCuDepartment"
                                name="drpCuDepartment">
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="txtCuFirstname" class="form-label required-field">First Name</label>
                        <input type="text" placeholder="First Name" name="txtCuFirstname" class="form-control" id="txtCuFirstname" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="txtCuLastname" class="form-label required-field">Last Name</label>
                        <input type="text" placeholder="Last Name" name="txtCuLastname" class="form-control" id="txtCuLastname" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="drpCuGender" class="form-label required-field">Gender </label>
                        <select class="form-control select2 select2-teal"
                                data-dropdown-css-class="select2-teal"
                                id="drpCuGender"
                                name="drpCuGender">
                            <option value="">--Select Gender--</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="txtCuDOB" class="form-label required-field">Date of Birth</label>
                        <input type="date" placeholder="DOB" name="txtCuDOB" class="form-control" id="txtCuDOB" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="txtCuEmail" class="form-label required-field">Email</label>
                        <input type="email" placeholder="Email" name="txtCuEmail" class="form-control" id="txtCuEmail" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="textCuPhoneNumber" class="form-label required-field">Contact Number</label>
                        <input type="number" placeholder="Contact No" name="textCuPhoneNumber" class="form-control" id="textCuPhoneNumber" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label for="drpCuCountry" class="form-label required-field">Country</label>
                        <select id="drpCuCountry" class="form-control select2 select2-teal"
                                data-dropdown-css-class="select2-teal"
                                onchange="fn_getUserState('drpCuState',null,this)" required>
                            <option selected value="">--Select Country--</option>
                        </select>
                    </div>

                    <!-- State -->
                    <div class="col-md-4 mb-3">
                        <label for="drpCuState" class="form-label required-field">State</label>
                        <select id="drpCuState" class="form-control select2 select2-teal"
                                data-dropdown-css-class="select2-teal"
                                onchange="fn_getUsercitiesbystateId('drpCuCity', null, this)" required>
                            <option value="">--Select State--</option>
                        </select>
                    </div>

                    <!-- City -->
                    <div class="col-md-4 mb-3">
                        <label for="drpCuCity" class="form-label required-field">City</label>
                        <select id="drpCuCity" class="form-control select2 select2-teal"
                                data-dropdown-css-class="select2-teal" required>
                            <option value="">--Select City--</option>
                        </select>
                    </div>

                    <div class="col-12 mb-3">
                        <label for="textCuAddress" class="form-label required-field">Address</label>
                        <textarea class="form-control" rows="3" placeholder="Address" id="textCuAddress" name="textCuAddress" required></textarea>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="passwordinput" class="form-label required-field">Password</label>
                        <div class="position-relative auth-pass-inputgroup">
                            <input type="password" class="form-control pe-5 password-input" onpaste="return false" placeholder="Enter Password" id="passwordinput" name="passwordinput" aria-describedby="passwordInput" required>
                            <button class="btn btn-link position-absolute end-0 top-0 text-decoration-none text-muted password-addon" type="button" id="password-addon"><i class="ri-eye-fill align-middle" style="color:#16989A;"></i></button>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="confirmpasswordinput" class="form-label required-field">Confirm Password</label>
                        <div class="position-relative auth-pass-inputgroup mb-3">
                            <input type="password" class="form-control pe-5 password-input" onpaste="return false" placeholder="Confirm Password" id="confirmpasswordinput" name="confirmpasswordinput" required>
                            <button class="btn btn-link position-absolute end-0 top-0 text-decoration-none text-muted password-addon" type="button" id="confirm-password-input"><i class="ri-eye-fill align-middle" style="color:#16989A;"></i></button>
                        </div>
                    </div>

                    <!-- Logo Upload -->
                    <div class="col-12 mb-3">
                        <label class="form-label">Image</label>
                        <div class="dropzone-area" id="dropzone">
                            <label for="filecuImage" class="dz-message">
                                <div class="dz-icon">
                                    <i class="ri-upload-cloud-2-fill"></i>
                                </div>
                                <div class="dz-text">
                                    <h5>Click to upload or drop an image here</h5>
                                    <p>(Only image files are accepted)</p>
                                </div>
                            </label>
                            <input type="file" accept="image/*" class="form-control d-none" id="filecuImage" />
                            <div id="imagePreview" class="mt-3 text-center"></div>
                        </div>
                    </div>

                </div>

                <!-- Form Actions -->
                <div class="text-end mt-4">
                    <button type="button" class="btn button-teal"
                            onclick="CreateUser()">
                        <i class="ri-save-line me-1"></i> Create
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>
<script type="text/javascript">
    var forms = Array.from(document.querySelectorAll("form .auth-pass-inputgroup"));
    forms.forEach(function (s) {
        var addons = Array.from(s.querySelectorAll(".password-addon"));
        addons.forEach(function (t) {

            t.addEventListener("click", function (t) {
                var e = s.querySelector(".password-input");
                if (e.type === "password") {
                    e.type = "text";
                } else {
                    e.type = "password";
                }
            });
        });
    });

    var password = document.getElementById("passwordinput");
    var confirm_password = document.getElementById("confirmpasswordinput");

    function validatePassword() {
        if (password.value !== confirm_password.value) {
            confirm_password.setCustomValidity("Passwords Don't Match");
        } else {
            confirm_password.setCustomValidity("");
        }
    }

    confirm_password.onkeyup = validatePassword;

    document.addEventListener("DOMContentLoaded", function () {
        var today = new Date().toISOString().split('T')[0];
        document.getElementById("txtCuDOB").value = today;
    });

        document.getElementById('filecuImage').addEventListener('change', function (e) {
        const file = e.target.files[0];
        const preview = document.getElementById('imagePreview');
        preview.innerHTML = ''; // Clear any previous image

        if (file && file.type.startsWith('image/')) {
            const reader = new FileReader();
            reader.onload = function (e) {
                const img = document.createElement('img');
                img.src = e.target.result;
                img.alt = "Selected Image";
                preview.appendChild(img);
            };
            reader.readAsDataURL(file);
        } else {
            preview.innerHTML = '<p class="text-danger">Please select a valid image file.</p>';
        }
    });

</script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/moduls/userdetailsscript.js" asp-append-version="true"></script>