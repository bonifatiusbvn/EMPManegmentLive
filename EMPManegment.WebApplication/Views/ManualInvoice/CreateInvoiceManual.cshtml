@model EMPManegment.EntityModels.ViewModels.ManualInvoice.ManualInvoiceMasterModel
@using EMPManegment.Web.Models;
@inject IHttpContextAccessor Accessor;
@inject UserSession _userSession
@inject EMPManegment.Web.Helper.Common CommonHelper

@{
    ViewData["Title"] = "CreateInvoiceManual";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}
<style>
    .error-border {
        border: 2px solid red;
    }
</style>
<input type="hidden" id="DollarAmount" />
<div class="row" style="margin-top:80px;">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between content-header">
            <h4 class="fm-header mb-sm-0">Create Manual Invoice</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">InvoicesManual</a></li>
                    <li class="breadcrumb-item active">Create Manual Invoice</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-lg-12">
        <div class="" id="invoiceList">
            <form id="CreateManualInvoiceForm">
                <div class="row g-3">
                    <div class="col-lg-6">
                        <div class="card fm-card">
                            <div class="card-header fm-card-header">
                                <div class="row align-items-center">
                                    <div class="col-8">
                                        <h5 class="mb-0" style="color:white;">Vendor Details (To:)</h5>
                                    </div>
                                    <div class="col-4" style="float:right;">
                                        @if (Model.InvoicesType != null)
                                        {
                                            <select class="form-control select2 select2-teal"
                                                    data-dropdown-css-class="select2-teal" id="ddlinvoicetype" name="ddlinvoicetype">
                                                <option value="@Model.InvoiceType">@Model.InvoicesType</option>
                                            </select>
                                        }
                                        else
                                        {
                                            <select class="form-control select2 select2-teal"
                                                    data-dropdown-css-class="select2-teal" id="ddlinvoicetype" name="ddlinvoicetype">
                                            </select>
                                        }
                                        <input type="hidden" id="txtinvoicetype" />
                                    </div>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-6 col-lg-6 ">
                                        <label for="textVendorName" class="form-label">Vendor Name <span class="text-danger">*</span></label>
                                        <input class="form-control valid" id="textVendorName" name="textVendorName" placeholder="Vendor Name" value="@Model.VendorName" />
                                    </div>
                                    <div class="col-6 col-lg-6 ">
                                        <label for="textVendorMobile" class="form-label ">Mobile No</label>
                                        <input type="text" id="textVendorMobile" class="form-control" placeholder="Mobile No" value="@Model.VendorPhoneNo" />
                                    </div>
                                </div>
                                <div class="row mt-3">
                                    <div class="col-6 col-lg-6">
                                        <label for="textVendorAddress" class="form-label ">Billing Address</label>
                                        <input type="text" id="textVendorAddress" class="form-control" placeholder="Address" value="@Model.VendorAddress" />
                                    </div>
                                    <div class="col-6 col-lg-6">
                                        <label for="textVendorGSTNumber" class="form-label ">GST NO</label>
                                        <input type="text" id="textVendorGSTNumber" class="form-control" placeholder="GST No" value="@Model.VendorGstNo" />
                                    </div>
                                    <input type="text" id="textProjectId" class="form-control" hidden value="@UserSession.ProjectId" />
                                    <input type="text" id="textCreatedById" class="form-control" hidden value="@_userSession.UserId" />
                                    <input type="text" id="textMIid" class="form-control" hidden value="@Model.Id" />
                                    <input type="text" id="textCreatedBy" class="form-control" hidden value="@Model.CreatedBy" />
                                    @{
                                        DateTime createdonDate = Model.CreatedOn != DateTime.MinValue ? Model.CreatedOn : DateTime.Now;
                                        string formattedCreatedonDate = createdonDate.ToString("yyyy-MM-dd");
                                    }
                                    <input type="date" id="textModelCreatedOn" class="form-control" hidden value="@formattedCreatedonDate" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="card fm-card">
                            <div class="card-header fm-card-header">
                                <div class="row align-items-center">
                                    <div class="col-10">
                                        <h5 class="mb-0 text-white">Invoice Details (From:)</h5>
                                    </div>
                                    <div class="col-2 text-end">
                                        <div class="custom-control custom-checkbox">
                                            <input class="custom-control-input custom-control-input-teal"
                                                   type="checkbox"
                                                   id="manualCheckedAll"
                                                   onclick="fillDetails()"
                                                   @(Model.CompanyName == "BONIFATIUS TECHNOLOGIES PRIVATE LIMITED" ? "checked" : "")>
                                            <label class="custom-control-label" for="manualCheckedAll"></label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div>
                                            <label for="textCompanyName" class="form-label">Company Name <span class="text-danger">*</span></label>
                                        </div>
                                        <div class="ms-auto">
                                            @if (Model.CompanyName == "BONIFATIUS TECHNOLOGIES PRIVATE LIMITED")
                                            {
                                                <input class="form-control valid" id="textCompanyName" name="textCompanyName" placeholder="Company Name" value="@Model.CompanyName" readonly />
                                            }
                                            else
                                            {
                                                <input class="form-control valid" id="textCompanyName" name="textCompanyName" placeholder="Company Name" value="@Model.CompanyName" />
                                            }
                                        </div>
                                    </div>
                                    <div class="col-5 col-lg-5">
                                        <label for="textPoId" class="form-label">Invoice No <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="textInvoiceNo" name="textInvoiceNo" placeholder="Invoice No" value="@Model.InvoiceNo" />
                                    </div>
                                    <div class="col-3 col-lg-3 ">
                                        <label for="textInvoiceDate" class="form-label">Invoice Date</label>
                                        @{
                                            DateTime invoiceDate = Model.InvoiceDate != DateTime.MinValue ? Model.InvoiceDate : DateTime.Now;
                                            string formattedDate = invoiceDate.ToString("yyyy-MM-dd");
                                        }
                                        <input type="date" id="textInvoiceDate" class="form-control" name="textInvoiceDate" placeholder="Select Order-Date" value="@formattedDate">
                                    </div>
                                </div>
                                <div class="row mt-3">
                                    <div class="col-6 col-lg-6">
                                        <label for="textCompanyBillingAddress" class="form-label">Address</label>
                                        @if (Model.CompanyAddress == "SF-203, Peridot Complex, B/S, Gail Office, Akota, Vadodara-390020")
                                        {
                                            <input type="text" id="textCompanyBillingAddress" name="textCompanyBillingAddress" class="form-control" placeholder="Billing Address" value="@Model.CompanyAddress" readonly />
                                        }
                                        else
                                        {
                                            <input type="text" id="textCompanyBillingAddress" name="textCompanyBillingAddress" class="form-control" placeholder="Billing Address" value="@Model.CompanyAddress" />
                                        }
                                    </div>
                                    <div class="col-6 col-lg-6">
                                        <label class="form-label">GST NO</label>
                                        @if (Model.CompanyGstNo == "24AAKCB0366M1ZJ")
                                        {
                                            <input type="text" id="textCompanyGstNo" class="form-control" placeholder="GST No" value="@Model.CompanyGstNo" readonly />
                                        }
                                        else
                                        {
                                            <input type="text" id="textCompanyGstNo" class="form-control" placeholder="GST No" value="@Model.CompanyGstNo" />
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!---- Product Details ---->
                    <div class="col-12">
                        <div class="card fm-card">
                            <div class="card-header">
                                <div class="d-flex align-items-center">
                                    <h5 class="card-title mb-0 flex-grow-1" style="font-size:20px;font-weight:600;color:#16989A;">Product Details</h5>
                                    <div class="flex-shrink-0">
                                        <div class="d-flex flex-wrap gap-2">
                                            <a class="btn button-teal" style="text-align:end;" id="ManualInvoiceAddproduct" onclick="AddProductButton()"><i class="fa-solid fa-circle-plus me-1"></i> Product</a>
                                            <span id="spnitembutton" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card-body pt-0">
                                <div class="table-wrapper">
                                    <table class="table fixed-header-table table-bordered table-striped">
                                        <thead class="table-secondary">
                                            <tr class="text-uppercase">
                                                <th>#</th>
                                                <th>Product</th>
                                                <th>HSN</th>
                                                <th>Quantity</th>
                                                <th>Qty Type</th>
                                                <th>
                                                    Price
                                                    <select class="form-selectborder-0 bg-light" id="currency-select" onchange="checkCurrencySelection()">
                                                        @if (Model.DollarPrice != null)
                                                        {
                                                            <option value="₹">(₹)</option>
                                                            <option value="$" selected onclick="checkCurrencySelection()">($)</option>
                                                        }
                                                        else
                                                        {
                                                            <option value="₹" selected>(₹)</option>
                                                            <option value="$">($)</option>
                                                        }

                                                    </select>
                                                    <div id="DollarModal" class="modal fade" tabindex="-1" role="dialog">
                                                        <div class="modal-dialog" role="document">
                                                            <div class="modal-content">
                                                                <form id="AddDollarAmountForm">
                                                                    <div class="modal-header bg-primary-subtle p-3">
                                                                        <h5 class="modal-title">$Price</h5>
                                                                        <button type="button" class="btn-close" onclick="CloseDollarModel()"></button>
                                                                    </div>
                                                                    <div class="modal-body">
                                                                        <div class="hstack gap-3 align-items-start">
                                                                            <div class="flex-grow-1">
                                                                                <label class="form-label">1$ = <span class="text-danger">*</span></label>
                                                                                <input type="text" id="txtDollarAmount" value="@Model.DollarPrice" placeholder="(₹)" />
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="button" class="btn btn-light" onclick="CloseDollarModel()">Close</button>
                                                                        <button type="button" class="btn button-teal" onclick="SaveDollarAmount()">Save</button>
                                                                    </div>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>

                                                </th>
                                                <th>
                                                    <div class="row">
                                                        <div class="col-sm-6">
                                                            Discount
                                                        </div>
                                                        <div class="col-sm-6">
                                                            Dis(%)
                                                        </div>

                                                    </div>
                                                </th>
                                                <th>
                                                    <div class="row">
                                                        <div class="col-sm-4">
                                                            GST (%)
                                                        </div>
                                                        <div class="col-sm-4">
                                                            IGST (%)
                                                        </div>
                                                        <div class="col-sm-4">
                                                            GST Amt (₹)
                                                        </div>

                                                    </div>
                                                </th>
                                                <th>Amount (₹)</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody id="addnewproductlink" class="table-body">
                                            @if (Model.ManualInvoiceDetails != null)
                                            {
                                                @Html.Partial("_AddProductPartialView.cshtml", Model.ManualInvoiceDetails)
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                            <div class="card-footer">
                                <table class="table align-middle mb-0 dt-responsive nowrap">
                                    <thead class="table align-middle mb-0">
                                        <tr>
                                            <th>#</th>
                                            <th>Total</th>
                                            <th id="TotalProductQuantity"></th>
                                            <th id="TotalProductPrice"></th>
                                            <th></th>
                                            <th id="TotalDiscountPrice"></th>
                                            <th></th>
                                            <th></th>
                                            <th></th>
                                            <th id="TotalProductGST"></th>
                                            <th></th>
                                            <th id="TotalProductAmount"></th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Additional Information -->
                    <div class="col-lg-6">
                        <div class="card fm-card">
                            <h5 class="card-header fm-card-header">Additional Information</h5>
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Buys Order No</label>
                                        <input type="text" id="textBuysOrderNo" class="form-control" placeholder="Buys OrderNo" name="textBuysOrderNo" value="@Model.BuyesOrderNo" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Buys Order Date</label>
                                        @{
                                            string Dateformat = Model?.BuyesOrderDate.HasValue ?? false ? Model.BuyesOrderDate.Value.ToString("yyyy-MM-dd") : string.Empty;
                                        }
                                        @if (Model.BuyesOrderDate != null)
                                        {
                                            <input type="date" id="textBuysOrderDate1" class="form-control" placeholder="Buys OrderDate" name="textBuysOrderDate" value="@Dateformat" />
                                        }
                                        else
                                        {
                                            <input type="date" id="textBuysOrderDate" class="form-control" placeholder="Buys OrderDate" name="textBuysOrderDate" />
                                        }
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Dispatch Doc No.</label>
                                        <input type="text" class="form-control" id="textDispatchDocNo" name="textDispatchDocNo" placeholder="Dispatch Doc No." value="@Model.DispatchDocNo">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Motor Vehicle No.</label>
                                        <input type="text" class="form-control" id="textMotorVehicleNo" name="textMotorVehicleNo" placeholder="Motor Vehicle No." value="@Model.MotorVehicleNo">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Dispatch Through</label>
                                        <input type="text" class="form-control" id="textDispatchThrough" name="textDispatchThrough" placeholder="Dispatch Through" value="@Model.DispatchThrough">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Destination</label>
                                        <input type="text" class="form-control" id="textDestination" name="textDestination" placeholder="Destination" value="@Model.Destination">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Payment Method <span class="text-danger">*</span></label>
                                        @if (Model.PaymentMethod != null)
                                        {
                                            <select class="form-control select2 select2-teal"
                                                    data-dropdown-css-class="select2-teal" id="txtpaymentmethod" name="txtpaymentmethod">
                                                <option selected value="@Model.PaymentMethod">@Model.PaymentMethodName</option>
                                            </select>
                                        }
                                        else
                                        {
                                            <select class="form-control select2 select2-teal"
                                                    data-dropdown-css-class="select2-teal" id="txtpaymentmethod" name="txtpaymentmethod">
                                            </select>
                                        }
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Payment Status<span class="text-danger">*</span></label>
                                        @if (Model.PaymentStatus != null)
                                        {
                                            <select class="form-control select2 select2-teal"
                                                    data-dropdown-css-class="select2-teal" id="txtpaymenttype" name="txtpaymenttype">
                                                <option selected value="@Model.PaymentStatus">@Model.PaymentStatusName</option>
                                            </select>
                                        }
                                        else
                                        {
                                            <select class="form-control select2 select2-teal"
                                                    data-dropdown-css-class="select2-teal" id="txtpaymenttype" name="txtpaymenttype">
                                            </select>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Shipping Address -->
                        <div class="card fm-card mt-3">
                            <h5 class="card-header fm-card-header">Shipping Address</h5>
                            <div class="card-body">
                                <div class="custom-control custom-checkbox">
                                    @{
                                        bool isSameAddress = Model.VendorAddress == Model.ShippingAddress;
                                    }
                                    <input class="custom-control-input custom-control-input-teal" type="checkbox" id="hideShippingAddress"
                                           onchange="toggleShippingAddress()" @(isSameAddress ? "checked" : "") />
                                    <label class="custom-control-label" for="hideShippingAddress">
                                        Is Your Billing Address the same as Shipping Address?
                                    </label>
                                </div>
                                <div id="shippingAddressFields" style="display:@(isSameAddress ? "none" : "block");">
                                    <textarea class="form-control" id="textShippingAddress" placeholder="Shipping Address">@Model.ShippingAddress</textarea>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Invoice Summary -->
                    <div class="col-lg-6">
                        <div class="card fm-card">
                            <h5 class="card-header fm-card-header">Invoice Summary</h5>
                            <div class="card-body">
                                <table class="table table-borderless">
                                    <tbody>
                                        <tr>
                                            <td class="p-2">
                                                <label class="form-label mb-1">Sub Total</label>
                                            </td>
                                            <td class="p-2">
                                                <input type="text" class="form-control border-0" id="cart-subtotal" placeholder="₹0.00" readonly />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="p-2">
                                                <label class="form-label mb-1">Total GST</label>
                                            </td>
                                            <td class="p-2">
                                                <input type="text" class="form-control border-0" id="totalgst" placeholder="₹0.00" readonly value="@Model.TotalGst" />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="p-2">
                                                <label class="form-label mb-1">Discount</label>
                                            </td>
                                            <td class="p-2">
                                                <input type="text" class="form-control border-0" id="cart-discount" placeholder="₹0.00" readonly />
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="p-2">
                                                <label class="form-label mb-1">Roundoff</label>
                                            </td>
                                            <td class="p-2">
                                                <input type="text" class="form-control bg-light border-0" name="txtroundOff" id="cart-roundOff" placeholder="₹0.00" min="-0.99" max="0.99" value="@Model.RoundOff" />
                                            </td>
                                        </tr>
                                        <tr class="border-top">
                                            <td class="p-2 pt-2">
                                                <label class="form-label mb-0 fw-bold">Total Amount</label>
                                            </td>
                                            <td class="p-2 pt-2">
                                                <input type="text" class="form-control border-0" id="cart-total" placeholder="₹0.00" readonly value="@Model.TotalAmount" />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="col-12">
                        <div class="text-end">
                            @if (Model.Id != Guid.Empty)
                            {
                                <button type="button" class="btn button-teal" id="UpdateManualInvoiceButton" onclick="UpdateManualInvoiceDetails()">
                                    <i class="ri-save-line me-1"></i> Update
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn button-teal" id="SaveManualInvoiceButton" onclick="InsertManualInvoiceDetails()">
                                    <i class="ri-file-add-line me-1"></i>Create
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!--end col-->
<script type="text/javascript">
    var userPermissions = '@Html.Raw(Json.Serialize(UserSession.FormPermisionData))';

    function fillDetails() {
        var isChecked = document.getElementById("manualCheckedAll").checked;
        var companyName = document.getElementById("textCompanyName");
        var billingAddress = document.getElementById("textCompanyBillingAddress");
        var gstNo = document.getElementById("textCompanyGstNo");

        if (isChecked) {
            companyName.value = "BONIFATIUS TECHNOLOGIES PRIVATE LIMITED";
            billingAddress.value = "SF-203, Peridot Complex, B/S, Gail Office, Akota, Vadodara-390020";
            gstNo.value = "24AAKCB0366M1ZJ";

            companyName.readOnly = true;
            billingAddress.readOnly = true;
            gstNo.readOnly = true;
        } else {
            companyName.value = "";
            billingAddress.value = "";
            gstNo.value = "";

            companyName.readOnly = false;
            billingAddress.readOnly = false;
            gstNo.readOnly = false;
        }
    }
</script>
<!--Invoice create init js-->
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/moduls/manualinvoicescript.js" asp-append-version="true"></script>


