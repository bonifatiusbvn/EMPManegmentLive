@model List<EMPManegment.EntityModels.ViewModels.ExpenseMaster.ExpenseDetailsView>
@using EMPManegment.Web.Models
@inject IHttpContextAccessor Accessor;
@inject UserSession _userSession

@{
    ViewData["Title"] = "ExpenseList";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}
<style>
    .ui-autocomplete {
        z-index: 1051;
        max-height: 150px;
        overflow-y: auto;
        overflow-x: hidden;
    }
</style>
<link href="~/assets/css/icons.min.css" rel="stylesheet" type="text/css" />

<!-- start page title -->
<div class="row" style="margin-top:80px;">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between content-header">
            <h4 class="fm-header mb-sm-0">Expense List</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">User Expenses</a></li>
                    <li class="breadcrumb-item active">Expenses</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- end page title -->
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <div class="row g-3">
                    <div class="col-12 col-lg-10">
                        <ul class="nav nav-tabs nav-tabs-custom nav-primary mb-3 d-flex align-items-center flex-wrap" role="tablist">
                            <li class="nav-item">
                                <a class="nav-link active All py-3" data-bs-toggle="tab" id="All"  role="tab">
                                    <i class="ri-arrow-left-right-fill me-1 align-bottom"></i>All Expense
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link py-3 Returns" data-bs-toggle="tab" id="Unapprove" role="tab">
                                    <i class="ri-close-circle-line me-1 align-bottom"></i>UnApproved Expense
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link py-3 Returns" data-bs-toggle="tab" id="TodayExpense" role="tab">
                                    <i class="ri-checkbox-circle-line me-1 align-bottom"></i>Today's Expense
                                </a>
                            </li>
                        </ul>
                    </div>
                    @if (UserSession.FormPermisionData.Any(a => a.FormName == "Expenses" && (a.Add == true)))
                    {
                        <div class="col-12 col-lg-2" style="text-align:end">
                            <button type="button" class="btn button-teal" id="Approve-actions" onclick="AllUserApproveExpense()" style="display:none;">
                                <i class="ri-filter-3-line align-bottom me-1"></i>Approve All
                            </button>
                            <a class="btn button-teal" onclick="DisplayAddExpenseModel()"><i class="fa-solid fa-circle-plus me-1"></i>Expense</a>
                        </div>
                    }
                </div>
            </div>
         
            <div class="card-body">
                <div id="AllExpenseTable" class="ag-theme-teal" style="height: 560px; width: 100%;"></div>
               @*  <div>
                    <div class="table-responsive" id="allExpenseUnApproved" style="display: none;">
                        <table class="table table-bordered dt-responsive nowrap table-striped align-middle dataTable no-footer dtr-inline" id="ExpenseTable">
