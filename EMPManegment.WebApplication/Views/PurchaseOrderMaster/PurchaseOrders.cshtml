@using EMPManegment.Web.Models
@model IEnumerable<EMPManegment.EntityModels.ViewModels.OrderModels.PurchaseOrderDetailView>
@inject IHttpContextAccessor Accessor;
@inject UserSession _userSession
@inject EMPManegment.Web.Helper.Common CommonHelper
@*@using X.PagedList;
@using X.PagedList.Mvc.Core;*@
@{
    ViewData["Title"] = "CreateOrder";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}


<div class="row" style="margin-top:80px;">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between content-header">
            <h4 class="fm-header mb-sm-0">Purchase Orders</h4>

            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Purchase Order</a></li>
                    <li class="breadcrumb-item active">Purchase Order List</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- end page title -->
<div class="container-fluid">
    <div class="row">
        <div class="col-lg-12">
            <div class="card" id="orderList">
                <div class="card-header">
                    <div class="row align-items-center">
                        <div class="col-12 col-lg-3">
                            <input class="form-control"
                                   id="txtPurchaseOrderSearch"
                                   placeholder="Search..." />
                        </div>
                        <div class="col-12 col-lg-2">
                            <select class="form-control select2 select2-teal"
                                    data-dropdown-css-class="select2-teal"
                                    id="txtPOCompanyName">
                            </select>
                            <input type="hidden" id="txtCompanyName" />
                        </div>
                        <div class="col-12 col-lg-1">
                            <button class="btn button-teal" id="toggleDateFilter">
                                <i class="fa fa-calendar" aria-hidden="true"></i><span class="d-none d-sm-inline" style="margin-left: 10px;">Date</span>
                            </button>
                            <div id="dateFilterContainer" class="date-filter-container" style="display: none;">
                                <div class="p-2 bg-light border">
                                    <label for="txtstartdatebox">From Date</label>
                                    <input type="date" id="txtstartdatebox" class="form-control mb-3" style="font-size: 15px;">
                                    <label for="txtenddatebox">To Date</label>
                                    <input type="date" id="txtenddatebox" class="form-control mb-3" style="font-size: 15px;">
                                    <button class="btn button-teal btn-block" id="applyFilters">Apply</button>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-2">
                            <button class="btn button-rest" style="margin-left: -30px;" onclick="ResetPurchaseOrderData()"> Reset</button>
                        </div>
                        @if (UserSession.FormPermisionData.Any(a => a.FormName == "Create Purchase Order" && (a.Add == true)))
                        {
                            <div class="col-12 col-lg-4" style="text-align:end">
                                <button class="btn button-teal" onclick="createPO()"><i class="fa-solid fa-circle-plus"></i> Purchase Order</button>
                                <button class="btn btn-soft-danger" id="remove-actions" onClick="deleteMultiple()"><i class="ri-delete-bin-2-line"></i></button>
                            </div>
                        }
                    </div>
                </div>
                <div class="card-body">
                    <div id="PurchaseOrderTable" class="ag-theme-teal" style="height: 600px; width: 100%;"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<!--Partail View-->
<div id="dvdeliveredstatus">
</div>

<script type="text/javascript">
    window.userFormPermissions = @Html.Raw(Json.Serialize(UserSession.FormPermisionData));
</script>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/moduls/purchaseorderdetailsscript.js" asp-append-version="true"></script>
