@model EMPManegment.EntityModels.ViewModels.ProjectModels.ProjectDetailView
@using EMPManegment.Web.Models
@inject IHttpContextAccessor Accessor;
@inject UserSession _userSession
@inject EMPManegment.Web.Helper.Common CommonHelper

@{
    ViewData["Title"] = "GetProjectDetails";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

@{
    var CompanyName = Model.ProjectTitle;
    var Titleinitial = string.Empty;
    var words = CompanyName.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
    if (words.Length > 0)
    {
        Titleinitial += char.ToUpper(words[0][0]);

        if (words.Length > 1)
        {
            Titleinitial += char.ToUpper(words[1][0]);
        }
    }
    var CompanyInitials = Titleinitial.ToUpper();
}

<div class="row" style="margin-top:80px;">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0">Project</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Project</a></li>
                    <li class="breadcrumb-item active">Project Overview</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid">
    <div class="row" style="margin-top:20px;">
        <div class="col-lg-12">
            <div class="card mt-n4 mx-n4 border-0">
                <div class="bg-primary-subtle">
                    <div class="card-body pb-0 px-4">
                        <div class="row mb-3">
                            <div class="col-md">
                                <div class="row align-items-center g-3">
                                    <div class="col-md-auto">
                                        <div class="avatar-md">
                                            @if (!string.IsNullOrEmpty(Model.ProjectImage))
                                            {
                                                <div class="avatar-title bg-white rounded-circle">
                                                    <img src="~/Content/Projects/@Model.ProjectImage" alt="" class="direct-chat-img">
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="avatar-title bg-white rounded-circle">
                                                    <div class="avatar-title bg-success-subtle text-success rounded-circle fs-20 border" style="height:50px;width:50px;">@CompanyInitials</div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-md">
                                        <div>
                                            <h4 class="fw-bold" id="projecttitle"><a class="text-body">@Model.ProjectTitle</a>(@Model.ShortName)</h4>
                                            <div class="hstack gap-3 flex-wrap">
                                                <div><i class="ri-building-line align-bottom me-1"></i></div>
                                                <div class="fw-medium" id="projecttype">@Model.ProjectType</div>
                                                <input type="text" id="projectid" value="@Model.ProjectId" hidden />
                                                <div class="vr"></div>
                                                <div>Create Date : <span class="fw-medium">@CommonHelper.GetCommonDateFormat(Model.ProjectStartDate)</span></div>
                                                <input type="hidden" value="@Model.ProjectStartDate" id="projectstartdate" />
                                                <div class="vr"></div>
                                                <div>Due Date : <span class="fw-medium" id="projectenddate"></span>@CommonHelper.GetCommonDateFormat(Model.ProjectEndDate)</div>
                                                <div class="vr"></div>
                                                <div class="badge rounded-pill bg-primary fs-12" id="projectstatus">@Model.ProjectStatus</div>
                                                <div class="badge rounded-pill bg-success fs-12" id="projectpriority">@Model.ProjectPriority</div>
                                                <input type="hidden" id="memberUpdatedby" value="@_userSession.UserId" />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-header p-2">
                            <ul class="nav nav-pills">
                                <li class="nav-item">
                                    <input type="hidden" value="@Model.ProjectId" id="txtprojectid" hidden />
                                    <a class="nav-link active" data-bs-toggle="tab" href="#project-overview" onclick="projectActivity('@Model.ProjectId')">
                                        Overview
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-bs-toggle="tab" href="#project-documents" onclick="showuploadDocuments('@Model.ProjectId')">
                                        Documents
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-bs-toggle="tab" href="#project-activities" onclick="projectActivity('@Model.ProjectId')">
                                        Activities
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" data-bs-toggle="tab" href="#project-teams" onclick="showTeamsPagination('@Model.ProjectId');">
                                        Team
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <!-- end card body -->
                    <!-- end modal -->
                    <!---Partial View 2--->
                </div>
            </div>
            <!-- end card -->
        </div>
        <!-- end col -->
    </div>
    <!-- end row -->
    <div class="row">
        <div class="col-lg-12">
            <div class="tab-content text-muted">
                <div class="tab-pane fade show active" id="project-overview" role="tabpanel">
                    <div class="row">
                        <div class="col-xl-9 col-lg-8">
                            <div class="card">
                                <div class="card-header align-items-center d-flex">
                                    <h5 class="card-title mb-0 flex-grow-1 fm-fmheader">Activity</h5>
                                </div><!-- end card header -->
                                <div class="card-body">
                                    <div data-simplebar style="height: 635px;" class="px-3 mx-n3 mb-2">
                                        <div class="card">
                                            <div class="card-body">
                                                <div id="projectActivityinoverview">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- end card body -->
                            </div>
                            <!-- end card -->
                        </div>
                        <!-- ene col -->
                        <div class="col-xl-3 col-lg-4">
                            <!----Partial View---->
                            <div class="card">
                                <div class="card-header align-items-center d-flex border-bottom-dashed">
                                    <div class="row w-100">
                                        <div class="col-6 d-flex align-items-center">
                                            <h3 class="card-title mb-0" id="showProjectMembers" onclick="showProjectMembers('@Model.ProjectId')" style="color:#16989A;font-weight:600;">
                                                Project Members
                                            </h3>
                                        </div>
                                        @if (UserSession.FormPermisionData.Any(a => a.FormName == "Projec tDetails" && a.Add == true))
                                        {
                                            <div class="col-6 text-end">
                                                <button type="button" class="btn button-teal" onclick="openmemberpop()">
                                                    <i class="ri-share-line me-1 align-bottom"></i>Add Member
                                                </button>
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div style="max-height: 250px; overflow-y: auto;">
                                        <table class="table table-striped">
                                            <tbody id="dvshowmembers">
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                <!-- end card body -->
                            </div>
                            <!-- end card -->
                            <!----Partial View---->
                            <div class="card">
                                <div class="card-header align-items-center d-flex border-bottom-dashed">
                                    <div class="row w-100">
                                        <div class="col-6 d-flex align-items-center">
                                            <h3 class="card-title" id="showProjectDocuments" onclick="showProjectDocuments('@Model.ProjectId')" style="color:#16989A;font-weight:600;">Attachments</h3>
                                        </div>
                                        <div class="col-6 text-end">
                                            <button type="button" class="btn button-teal" onclick="docmodalopen()">
                                                <i class="ri-upload-2-fill me-1 align-bottom"></i>Upload
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div style="max-height: 250px; overflow-y: auto;">
                                        <div id="dvshowdocuments"></div>
                                    </div>
                                </div>
                                <!-- end card body -->
                            </div>
                            <!-- end card -->
                        </div>
                        <!-- end col -->
                    </div>
                    <!-- end row -->
                </div>
                <!-- end tab pane -->
                <div class="tab-pane fade" id="project-documents" role="tabpanel">
                    <div id="dvuploadDocuments"></div>
                </div>
                <!-- end tab pane -->
                <div class="tab-pane fade" id="project-activities" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            <div id="invoiceactivity">
                            </div>
                            <div id="projectActivity">
                            </div>
                        </div>
                    </div>
                </div>
                <!-- end tab pane -->
                <div class="tab-pane fade" id="project-teams" role="tabpanel">
                    <div id="dvshowteam"></div>
                </div>
            </div>
        </div>
    </div>
    <!-- end row -->
</div>

<div class="modal fade" id="inviteMembersModal">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-teal p-3">
                <h4 class="modal-title" style="color:white;">Members</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-8 mb-3">
                       @*  <label class="form-label">Select Multiple Members</label> *@
                        <select class="form-control multiple-select select2-teal"
                                data-dropdown-css-class="select2-teal"
                                multiple="multiple"
                                id="projectMemberDropdown"
                                name="projectMemberDropdown">
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <button type="button" class="btn button-teal" onclick="invitemember()">Add</button>
                    </div>
                </div>
                <div class="mb-4 d-flex align-items-center">
                    <div class="me-2">
                        <h5 class="mb-0 fs-13">Project Members :</h5>
                    </div>
                </div>
                <div id="dvinvitemember">
                </div>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
</div>
<!-- Modal -->
<div class="modal fade zoomIn" id="adddocuments" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class=" modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary-subtle p-3">
                <h5 class="modal-title" id="exampleModalLabel">Create Deals</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="frmtaskdetails">
                    <div class="mb-3">
                        <label for="taskType" class="form-label">Task Type</label>
                        <select class="form-control" id="taskType" name="taskType">
                            <option selected disabled value=""></option>
                        </select>
                        <input type="hidden" class="form-control" id="txtTaskType">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Task Title</label>
                        <input type="text" id="dealTitle" class="form-control" name="dealTitle" placeholder="Enter title" />
                    </div>
                    <div class="mb-3">
                        <label for="ddlusername" class="form-label">Task ProvideTo</label>
                        <select class="form-control" id="ddlusername" name="ddlusername">
                            <option selected disabled value=""></option>
                        </select>
                        <input type="hidden" class="form-control" id="txtguserid">
                    </div>
                    <div class="mb-3">
                        <label for="dueDate" class="form-label">Task Start-Date</label>
                        <input type="datetime-local" class="form-control material_blue" id="txtdatetime" name="txtdatetime" />
                    </div>
                    <div class="mb-3">
                        <label for="dealEmail" class="form-label">Task End-Date</label>
                        <input type="datetime-local" class="form-control material_blue" id="txtenddatetime" name="txtenddatetime">
                    </div>
                    <div class="mb-3">
                        <label for="contactDescription" class="form-label">Task Description</label>
                        <textarea class="form-control " id="contactDescription" rows="3" placeholder="Enter description" name="contactDescription"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" id="close-modal" data-bs-dismiss="modal" onclick="ClearTextBox()">Close</button>
                <button type="submit" class="btn button-teal" onclick="btnSaveTaskDetail();" id="taskDetails" value="Validate">Save</button>
            </div>
        </div>
    </div>
</div>
<!--end modal-->
<!-- Modal -->
<div class="modal fade" id="documentUploadModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-teal p-3">
                <h5 class="modal-title" style="color:white;">Upload Document</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="btn btn-default btn-file">
                        <i class="fas fa-paperclip"></i> Attachment
                        <input type="file" class="form-control" name="attachment" id="txtDocumentName">
                    </div>
                </form>
            </div>
            <div class="modal-footer" style="text-align:end;">
                <button type="button" class="btn btn-secondary" id="close-modal" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn button-teal" onclick="addProjectDocument()">Upload</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
</div>
<!-- Modal -->
<div class="modal fade" id="deleteOrderModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-5 text-center">
                <img src="~/lteassets/icons/delete.png" style="height:150px;width:150px" />
                <div class="mt-4 text-center">
                    <h4>You are about to delete a Member ?</h4>
                    <p class="text-muted fs-15 mb-4">
                        Deleting your project member will remove him form this current Project.
                    </p>
                    <div class="hstack gap-2 justify-content-center remove">
                        <button class="btn btn-secondary" id="deleteRecord-close" data-bs-dismiss="modal">
                            Close
                        </button>
                        <button class="btn button-teal" id="delete-product" oncllick="deleteProjectMember(Id)">
                            Yes,Delete It
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- end modal -->
<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/moduls/projectdetailsscript.js" asp-append-version="true"></script>
<script type="text/javascript">
    document.getElementById("showProjectMembers").click();
    document.getElementById("showProjectDocuments").click();
</script>
