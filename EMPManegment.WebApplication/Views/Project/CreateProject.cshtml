@model EMPManegment.EntityModels.ViewModels.ProjectModels.ProjectDetailView
@using EMPManegment.Web.Models;
@inject IHttpContextAccessor Accessor;
@inject UserSession _userSession

@{
    ViewData["Title"] = "CreateProject";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}
<style>
    #projectPriority-error, #projectTitle-error, #projectDescription-error, #projectStatus-error, #projectdeadline-error,
    #txtBuildingName-error, #txtProjectArea-error, #txtProjectPincode-error, #projectCountry-error, #ProjectState-error, #ProjectCity-error,
    #projectType-error, #projectHead-error, #projectLocation-error, #projectStartDate-error {
        color: #dc3545;
        font-size: 90%;
    }
    .Add_Members {
        margin-left: 200px;
    }

    #imagePreview img {
        max-width: 150px;
        height: auto;
        border-radius: 10px;
        margin-top: 15px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    }

    .logo-preview {
        max-width: 150px;
        height: auto;
        border-radius: 10px;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    }

    @@media only screen and (max-width: 768px) {

        .Add_Members {
            margin-left: 150px;
        }

        .Projectform-container {
            background: rgba(255, 255, 255, 0.9);
            width: 1600px;
            margin-left: -80px;
        }
    }

    @@media only screen and (min-width: 768px) and (max-width: 1024px) {

        .Add_Members {
            margin-left: 435px;
        }
    }

    @@media only screen and (min-width: 1024px) and (max-width: 1370px) {

        .Add_Members {
            margin-left: 35px;
        }
    }
</style>

<div class="row" style="margin-top:80px;">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between content-header">
            <h4 class="fm-header mb-sm-0">Create Project</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Projects</a></li>
                    <li class="breadcrumb-item active">Create Project</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- end page title -->
<div class="fm-container col-lg-12">
    <div class="auth-page-wrapper  py-3 d-flex justify-content-center align-items-center min-vh-100">
        <div class="row">
            <div class="col-lg-8">
                <form id="formprojectdetails">
                    <div class="card fm-card">
                        <div class="card-header fm-card-header">
                            Project Details
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label required-field" for="projectTitle">Project Title</label>
                                <input type="text" class="form-control" id="projectTitle" placeholder="Enter project title" name="projectTitle" value="@Model.ProjectTitle">
                                <input type="hidden" id="textprojectId" value="@Model.ProjectId">
                                <input type="hidden" id="textProjectUserId" value="@_userSession.UserId">
                            </div>
                            <div class="mb-3">
                                <label class="form-label required-field" for="projectDescription">Project Description</label>
                                @if (Model.ProjectDescription != null)
                                {
                                    <textarea class="form-control " id="projectDescription" rows="3" placeholder="Enter description" name="projectDescription">@Model.ProjectDescription</textarea>
                                }
                                else
                                {
                                    <textarea class="form-control " id="projectDescription" rows="3" placeholder="Enter description" name="projectDescription"></textarea>
                                }
                            </div>
                            <div class="row">
                                <div class="col-lg-4">
                                    <div class="mb-3 mb-lg-0">
                                        <label for="projectPriority" class="form-label required-field">Priority</label>
                                        @if (Model.ProjectPriority != null)
                                        {
                                            <select class="form-control select2 select2-teal"
                                                    data-dropdown-css-class="select2-teal" id="projectPriority" name="projectPriority">
                                                <option value="@Model.ProjectPriority">@Model.ProjectPriority</option>
                                                @if (Model.ProjectPriority == "Low")
                                                {
                                                    <option value="High">High</option>
                                                    <option value="Medium">Medium</option>
                                                }
                                                @if (Model.ProjectPriority == "Medium")
                                                {
                                                    <option value="High">High</option>
                                                    <option value="Low">Low</option>
                                                }
                                                @if (Model.ProjectPriority == "High")
                                                {
                                                    <option value="Medium">Medium</option>
                                                    <option value="Low">Low</option>
                                                }

                                            </select>
                                        }
                                        else
                                        {
                                            <select class="form-control select2 select2-teal"
                                                    data-dropdown-css-class="select2-teal" id="projectPriority" name="projectPriority">
                                                <option value="" selected>---Select Project Priority---</option>
                                                <option value="High">High</option>
                                                <option value="Medium">Medium</option>
                                                <option value="Low">Low</option>
                                            </select>
                                        }
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div class="mb-3 mb-lg-0">
                                        <label for="projectStatus" class="form-label required-field">Status</label>
                                        @if (Model.ProjectStatus != null)
                                        {
                                            <select class="form-control select2 select2-teal"
                                                    data-dropdown-css-class="select2-teal" id="projectStatus" name="projectStatus">
                                                <option value="@Model.ProjectStatus">@Model.ProjectStatus</option>
                                                @if (Model.ProjectStatus != "Inprogress")
                                                {
                                                    <option value="Inprogress">Inprogress</option>
                                                }
                                                @if (Model.ProjectStatus != "Completed")
                                                {
                                                    <option value="Completed">Completed</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <select class="form-control select2 select2-teal"
                                                    data-dropdown-css-class="select2-teal" id="projectStatus" name="projectStatus">
                                                <option value="" selected disabled>---Select Project Status---</option>
                                                <option value="Inprogress">Inprogress</option>
                                                <option value="Completed">Completed</option>
                                            </select>
                                        }
                                    </div>
                                </div>
                                <div class="col-lg-4">
                                    <div>
                                        <label for="projectdeadline" class="form-label  required-field">Deadline </label>
                                        @{
                                            DateTime deadlineDate = Model.ProjectDeadline != DateTime.MinValue ? Model.ProjectDeadline : DateTime.Now;
                                            string formattedDeadlineDate = deadlineDate.ToString("yyyy-MM-dd");
                                        }
                                        @if (Model.ProjectDeadline != DateTime.MinValue)
                                        {
                                            <input type="date" class="form-control material_blue" id="projectdeadline" name="projectdeadline" value="@formattedDeadlineDate" />
                                        }
                                        else
                                        {
                                            <input type="date" class="form-control material_blue" id="projectdeadline" name="projectdeadline" />
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- end card body -->
                    </div>
                    <!-- end card -->
                    <div class="card fm-card">
                        <div class="card-body">
                            <div class="col-12 mb-3">
                                <label class="form-label  required-field">BuildingName</label> <br />
                                @if (Model.BuildingName != null)
                                {
                                    <textarea type="text" class="form-control" rows="3" placeholder="BuildingName" id="txtBuildingName" name="txtBuildingName">@Model.BuildingName</textarea>
                                }
                                else
                                {
                                    <textarea type="text" class="form-control" rows="3" placeholder="BuildingName" id="txtBuildingName" name="txtBuildingName"></textarea>
                                }
                            </div>
                            <div class="row">
                                <div class="col-6 mb-3">
                                    <label class="form-label  required-field">Area </label>
                                    <input type="text" class="form-control" placeholder="Area" id="txtProjectArea" name="txtProjectArea" value="@Model.Area">
                                </div>
                                <div class="col-6 mb-3">
                                    <label class="form-label  required-field">Pincode </label>
                                    <input type="number" class="form-control" placeholder="Pincode" id="txtProjectPincode" name="txtProjectPincode" value="@Model.PinCode">
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-4 mb-3">
                                    <label class="form-label  required-field">Country </label>
                                    @if (Model.Country != null)
                                    {
                                        <select id="projectCountry" name="projectCountry" class="form-control select2 select2-teal"
                                                data-dropdown-css-class="select2-teal" onchange="fn_getProjectState('ProjectState',null,this)">
                                            <option value="@Model.Country">@Model.CountryName</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <select id="projectCountry" name="projectCountry" class="form-control select2 select2-teal"
                                                data-dropdown-css-class="select2-teal" onchange="fn_getProjectState('ProjectState',null,this)">
                                        </select>
                                    }
                                    <input type="hidden" id="txtprojectCountry" value="" />
                                </div>
                                <div class="col-4 mb-3">
                                    <label class="form-label  required-field">State</label>
                                    @if (Model.State != null)
                                    {
                                        <select id="ProjectState" name="ProjectState" class="form-control select2 select2-teal"
                                                data-dropdown-css-class="select2-teal" onchange="fn_getProjectcitiesbystateId('ProjectCity', null, this)">
                                            <option value="@Model.State">@Model.StateName</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <select id="ProjectState" name="ProjectState" class="form-control select2 select2-teal"
                                                data-dropdown-css-class="select2-teal" onchange="fn_getProjectcitiesbystateId('ProjectCity', null, this)">
                                        </select>
                                    }
                                    <input type="hidden" id="txtProjectState" value="" />
                                </div>
                                <div class="col-4 mb-3">
                                    <label class="form-label">City <span class="text-danger">*</span></label>
                                    @if (Model.City != null)
                                    {
                                        <select id="ProjectCity" name="ProjectCity" class="form-control select2 select2-teal"
                                                data-dropdown-css-class="select2-teal">
                                            <option value="@Model.City">@Model.CityName</option>
                                        </select>
                                    }
                                    else
                                    {
                                        <select id="ProjectCity" name="ProjectCity" class="form-control select2 select2-teal"
                                                data-dropdown-css-class="select2-teal">
                                        </select>
                                    }
                                    <input type="hidden" id="txtProjectCity" value="" />
                                </div>
                                <!-- Logo Upload -->
                                <div class="col-12 mb-3">
                                    <label class="form-label">Thumbnail Image</label>
                                    <div class="dropzone-area" id="dropzone">
                                        <label for="fileUpload" class="dz-message">
                                            <div class="dz-icon">
                                                <i class="ri-upload-cloud-2-fill"></i>
                                            </div>
                                            <div class="dz-text">
                                                <h5>Click to upload or drop an image here</h5>
                                                <p>(Only image files are accepted)</p>
                                            </div>
                                        </label>
                                        <input type="file" accept="image/*" class="form-control d-none" id="fileUpload" name="projectImage" />

                                        <!-- Logo Preview on Load -->
                                        <div id="imagePreview" class="mt-3 text-center">
                                            @if (!string.IsNullOrEmpty(Model.ProjectImage))
                                            {
                                                <div class="d-inline-block position-relative">
                                                    <img src="~/Content/Projects/@Model.ProjectImage" alt="Project Logo" class="logo-preview" id="existingLogo" />
                                                    <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 remove-logo" onclick="removeExistingLogo()">×</button>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <span id="currentProjectImageName" class="d-none">@Model.ProjectImage</span>
                            </div>
                        </div>
                    </div>
                    <!-- end card -->

                </form>
            </div>
            <!-- end col -->
            <div class="col-lg-4">
                <form id="frmprojectdetails">
                    <div class="card fm-card">
                        <div class="card-header fm-card-header">
                            Other Details
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label for="projectType" class="form-label">Project Name</label>
                                <input type="text" class="form-control material_blue" id="projectname" name="projectname" value="@ViewBag.ProjectName" readonly />
                            </div>
                            <div class="mb-3">
                                <label for="projectType" class="form-label  required-field">Project Type</label>
                                <input type="text" class="form-control material_blue" id="projectType" name="projectType" placeholder="Enter Project Type" value="@Model.ProjectType" />
                            </div>
                            <div class="mb-3">
                                <label for="projectStartDate" class="form-label  required-field">Project Start Date </label>
                                @{
                                    DateTime startDate = Model.ProjectStartDate != DateTime.MinValue ? Model.ProjectStartDate : DateTime.Now;
                                    string formattedStartDate = startDate.ToString("yyyy-MM-dd");
                                    string maxDate = DateTime.Now.ToString("yyyy-MM-dd");
                                }
                                @if (Model.ProjectStartDate != DateTime.MinValue)
                                {
                                    <input type="date" class="form-control material_blue" id="projectStartDate" name="projectStartDate" max="@maxDate" value="@formattedStartDate" />
                                }
                                else
                                {
                                    <input type="date" class="form-control material_blue" id="projectStartDate" name="projectStartDate" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                }
                            </div>
                            <div class="mb-3">
                                <label for="projectEndDate" class="form-label">Project End Date</label>
                                @{
                                    DateTime endDate = Model.ProjectEndDate != DateTime.MinValue ? Model.ProjectEndDate : DateTime.Now;
                                    string formattedEndDate = endDate.ToString("yyyy-MM-dd");
                                }
                                @if (Model.ProjectEndDate != DateTime.MinValue)
                                {
                                    <input type="date" class="form-control material_blue" id="projectEndDate" name="projectEndDate" value="@formattedEndDate">
                                }
                                else
                                {
                                    <input type="date" class="form-control material_blue" id="projectEndDate" name="projectEndDate">
                                }
                            </div>
                        </div>
                        <!-- end card body -->
                    </div>
                    <!-- end card -->
                    <div class="card fm-card">
                        <div class="card-header align-items-center d-flex border-bottom-dashed fm-card-header">
                            Members
                            <button type="button" class="btn btn-block Add_Members" style="background-color: #96d17d;" data-bs-toggle="modal" data-bs-target="#ProjectHeadModal" onclick="ProjectHeadMemberList()"><i class="ri-share-line me-1 align-bottom"></i> Select Head</button>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label for="projectHead" class="form-label  required-field">Project Head </label>
                                <input type="text" class="form-control material_blue" id="projectHead" name="projectHead" placeholder="Enter Project Head" value="@Model.ProjectHead" />
                            </div>
                        </div>
                        <!-- end card body -->
                    </div>
                    <!-- end card -->
                </form>
                <div class="modal fade" id="ProjectHeadModal" tabindex="-1" aria-labelledby="ProjectHeadModalLabel" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0  fm-form">
                            <div class="modal-header p-3 ps-4 bg-teal">
                                <h5 class="modal-title" id="ProjectHeadModalLabel" style="color:white">Members</h5>
                                <button type="button" class="btn-close" id="closebtn" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body p-4">
                                <div class="search-box mb-3">
                                    <input type="text" class="form-control bg-light border-light" id="SearchBtn" placeholder="Search here...">
                                    <i class="ri-search-line search-icon"></i>
                                </div>
                                <div class="mb-4 d-flex align-items-center">
                                    <div class="me-2">
                                        <h5 class="mb-0 fs-13">Add Members :</h5>
                                    </div>
                                </div>
                                <div id="dvinvitemember"></div>
                            </div>
                        </div>
                        <!-- end modal-content -->
                    </div>
                    <!-- modal-dialog -->
                </div>
                <!-- end modal -->
            </div>
            <!-- end col -->
            <div class="text-end mb-3">
                @if (Model.ProjectId != null)
                {
                    <button type="button" class="btn button-teal btn-lg" onclick="fn_UpdateProjectDetail()" id="updateProjectDetails" style="width: 160px;height: 50px;">Update</button>
                }
                else
                {
                    <button type="button" class="btn button-teal"
                            onclick="btnCreateProjectDetail()" id="projectDetails">
                        <i class="ri-save-line me-1"></i> Create
                    </button>                }
            </div>
        </div>
    </div>
</div>
<!-- ckeditor -->
<!-- dropzone js -->

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script type="text/javascript">

     $(document).ready(function () {
        let countryId = $('#projectCountry').val();
        let stateId = '@Model.State';
        let cityId = '@Model.City';

        if (countryId) {
            fn_getProjectState('ProjectState', countryId, null, function () {
                if (stateId) {
                    $('#ProjectState').val(stateId).trigger('change');

                    fn_getProjectcitiesbystateId('ProjectCity', stateId, null, function () {
                        if (cityId) {
                            $('#ProjectCity').val(cityId).trigger('change');
                        }
                    });
                }
            });
        }
    });

    document.addEventListener("DOMContentLoaded", function () {
        var today = new Date().toISOString().split('T')[0];
        document.getElementById("projectdeadline").value = today;
        document.getElementById("projectStartDate").value = today;
        document.getElementById("projectEndDate").value = today;
    });

            document.getElementById('fileUpload').addEventListener('change', function (e) {
        const file = e.target.files[0];
        const preview = document.getElementById('imagePreview');
        preview.innerHTML = ''; // Clear any previous image/logo

        if (file && file.type.startsWith('image/')) {
            const reader = new FileReader();
            reader.onload = function (e) {
                const img = document.createElement('img');
                img.src = e.target.result;
                img.alt = "Selected Image";
                img.className = "logo-preview";
                preview.appendChild(img);
            };
            reader.readAsDataURL(file);
        } else {
            preview.innerHTML = '<p class="text-danger">Please select a valid image file.</p>';
        }
    });

    function removeExistingLogo() {
        document.getElementById('imagePreview').innerHTML = '<p class="text-muted">Logo removed. You can upload a new one.</p>';
        document.getElementById('IsLogoRemoved').value = 'true'; // signal to remove on server
    }

</script>

<script src="~/moduls/projectdetailsscript.js" asp-append-version="true"></script>