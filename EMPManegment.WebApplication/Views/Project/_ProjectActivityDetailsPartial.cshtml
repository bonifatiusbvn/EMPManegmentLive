@using EMPManegment.Web.Models
@model IEnumerable<EMPManegment.EntityModels.ViewModels.ProjectModels.ProjectActivityDetailsModel>
@inject UserSession _userSession;
@inject EMPManegment.Web.Helper.Common CommonHelper


<div style="max-height: 600px; overflow-y: auto;">
    @foreach (var item in Model)
    {
        var imageUrl = !string.IsNullOrEmpty(item.Image) ? Url.Content($"~/{item.Image}") : null;
        var initials = (!string.IsNullOrEmpty(item.FirstName) && !string.IsNullOrEmpty(item.LastName)) ? $"{item.FirstName[0]}{item.LastName[0]}".ToUpper() : "";
        var badgeHtml = "";
        var taskDate = item.TaskDate;

        if (!string.IsNullOrEmpty(item.TaskStatus))
        {
            var badgeClass = item.TaskStatus switch
            {
                "Working" => "bg-warning",
                "Completed" => "bg-success",
                "Pending" => "bg-primary",
                "InReview" => "bg-secondary",
                _ => "bg-secondary"
            };
            badgeHtml = $"<span class=\"badge {badgeClass} text-uppercase\">{item.TaskStatus}</span>";
        }
        else if (!string.IsNullOrEmpty(item.TaskStatus))
        {
            badgeHtml = $"<span class=\"badge bg-danger-subtle text-danger\">{item.TaskStatus}</span>";
        }

        <div class="d-flex mb-3  py-2">
            <div class="flex-shrink-0 me-3">
                @if (!string.IsNullOrEmpty(imageUrl))
                {
                    <img src="@imageUrl" class="rounded-circle" style="height:40px;width:40px;" />
                }
                else
                {
                    <div class="avatar-title bg-success-subtle text-success rounded-circle fs-13"
                         style="height:40px;width:40px;display:flex;align-items:center;justify-content:center;">
                        @initials
                    </div>
                }
            </div>
            <div class="flex-grow-1">
                <h6 class="mb-1">@item.UserName</h6>
                <p class="text-muted mb-2">
                    @if (item.RecordType == "Invoice")
                    {
                        @:Created Invoice <strong>@item.Title</strong>
                    }
                    else
                    {
                        @item.Title <span>@Html.Raw(badgeHtml)</span>
                    }
                </p>
                <small class="text-muted">@CommonHelper.GetCommonDateFormat(taskDate ?? DateTime.MinValue)</small>
            </div>
        </div>
    }
</div>