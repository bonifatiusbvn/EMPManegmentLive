@model List<EMPManegment.EntityModels.ViewModels.Invoice.InvoiceViewModel>
@using EMPManegment.Web.Models;
@inject IHttpContextAccessor Accessor;
@inject UserSession _userSession

@{
    ViewData["Title"] = "InvoiceListView";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

<!-- start page title -->
<div class="row" style="margin-top:80px;">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between content-header">
            <h4 class="fm-header mb-sm-0">Invoice List</h4>
            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Invoices</a></li>
                    <li class="breadcrumb-item active">InvoicesListView</li>
                </ol>
            </div>
        </div>
    </div>
</div>
<!-- end page title -->

<div class="row">
    <div class="col-lg-12">
        <div class="card" id="invoiceList">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col-12 col-lg-3">
                        <input class="form-control"
                               id="txtInvoiceSearch"
                               placeholder="Search..." />
                    </div>
                    <div class="col-12 col-lg-2">
                        <select class="form-control select2 select2-teal"
                                data-dropdown-css-class="select2-teal"
                                id="txtInvoiceCompanyName">
                        </select>
                        <input type="hidden" id="txtCompanyName" />
                    </div>
                    <div class="col-12 col-lg-2">
                        <select class="form-control select2 select2-teal"
                                data-dropdown-css-class="select2-teal"
                                id="txtInvoiceVendorName">
                        </select>
                        <input type="hidden" id="txtVendorName" />
                    </div>
                    <div class="col-12 col-lg-1">
                        <button class="btn button-teal" id="toggleDateFilter">
                            <i class="fa fa-calendar" aria-hidden="true"></i><span class="d-none d-sm-inline" style="margin-left: 10px;">Date</span>
                        </button>
                        <div id="dateFilterContainer" class="date-filter-container" style="display: none;">
                            <div class="p-2 bg-light border">
                                <label for="txtstartdatebox">From Date</label>
                                <input type="date" id="txtstartdatebox" class="form-control mb-3" style="font-size: 15px;">
                                <label for="txtenddatebox">To Date</label>
                                <input type="date" id="txtenddatebox" class="form-control mb-3" style="font-size: 15px;">
                                <button class="btn button-teal btn-block" id="applyFilters">Apply</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-2">
                        <button class="btn button-rest" style="margin-left: -30px;" onclick="ResetInvoiceFilters()"> Reset</button>
                    </div>
                    @if (UserSession.FormPermisionData.Any(a => a.FormName == "Create Invoice" && (a.Add == true)))
                    {
                        <div class="col-12 col-lg-2" style="text-align:end">
                            <button class="btn button-teal" onclick="createInvoice()"><i class="fa-solid fa-circle-plus"></i> Invoice</button>
                        </div>
                    }
                </div>
            </div>
            <div class="card-body">
                <div id="invoiceTable" class="ag-theme-teal" style="height: 600px; width: 100%;"></div>
            </div>
        </div>
        <!--Update Invoice Modal -->
        <div class="modal fade" id="UpdateInvoiceModel" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-light p-3">
                        <h6 class="modal-title" id="exampleModalLabel">Update Invoice</h6><h7 class="modal-title" id="txtinvoiceno" style="margin-left:30px;"></h7>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="close-modal"></button>
                    </div>
                    <form class="tablelist-form" autocomplete="off" id="UpdateInvoiceDetailsForm">
                        <div class="modal-body">
                            <div class="mb-3">
                                <label for="date-field" class="form-label">Invoice Date</label>
                                <input type="datetime-local" data-date-format="d M, Y" data-enable-time id="txtinvoicedate" name="txtinvoicedate" class="form-control" />
                                <input type="hidden" id="txtid" class="form-control" />
                                <input type="hidden" id="txtUpdatedBy" value="@_userSession.UserId" />
                            </div>

                            <div class="mb-3">
                                <label for="customername-field" class="form-label">Company Name</label>
                                <input type="text" id="txtcompanyname" name="txtcompanyname" class="form-control" placeholder="Enter Company name" />
                            </div>

                            <div class="row gy-4 mb-3">
                                <div class="col-md-6">
                                    <div>
                                        <label for="amount-field" class="form-label">Amount</label>
                                        <input type="text" id="txtamount" name="txtamount" class="form-control" placeholder="Total amount" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div>
                                        <label for="payment-field" class="form-label">Payment Method</label>
                                        <select class="form-control" data-trigger name="txtpaymentmethod" id="txtpaymentmethod">
                                            <option selected disabled value="">---Select Payment Method---</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row gy-4 mb-3">
                                <div class="col-md-6">
                                    <div>
                                        <label for="payment-field" class="form-label">Status</label>
                                        <select class="form-control" data-trigger name="txtstatus" id="txtstatus">
                                            <option selected disabled value="">Select Status</option>
                                            <option value="Pending">Pending</option>
                                            <option value="Confirm">Confirm</option>
                                            <option value="Complete">Complete</option>
                                            <option value="Cancel">Cancel</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <div class="hstack gap-2 justify-content-end">
                                <button type="button" class="btn btn-danger btn-default m-1" id="close-modal" data-bs-dismiss="modal">Close</button>
                                <button type="button" class="btn button-teal" onclick="UpdateInvoiceDetails()" id="updatedetailbtn">Update</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <!--end modal -->
    </div>
</div>
<!--end row-->
<script type="text/javascript">
    window.userFormPermissions = @Html.Raw(Json.Serialize(UserSession.FormPermisionData));
</script>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/moduls/invoicemasterscript.js" asp-append-version="true"></script>
<script src="~/moduls/purchaseorderdetailsscript.js" asp-append-version="true"></script>
