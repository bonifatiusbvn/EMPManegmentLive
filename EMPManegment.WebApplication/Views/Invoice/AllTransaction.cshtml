@using EMPManegment.Web.Models;
@inject IHttpContextAccessor Accessor;
@inject UserSession _userSession

@{
    ViewData["Title"] = "GetAllTransaction";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}
<link href="~/assets/css/icons.min.css" rel="stylesheet" type="text/css" />

<div class="row" style="margin-top:80px;">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between content-header">
            <h4 class="fm-header mb-sm-0">Transactions List</h4>

            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Payment Transactions</a></li>
                    <li class="breadcrumb-item active">GetAllTransction</li>
                </ol>
            </div>

        </div>
    </div>
</div>
<!-- end page title -->


<div class="row" id="contactList">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <div class="row">
                    <div class="col-12 col-lg-2">
                        <input class="form-control"
                               id="txtoutwardSearch"
                               placeholder="Search" />
                    </div>
                    <div class="col-12 col-lg-2">
                        <select class="form-control select2 select2-maroon"
                                data-dropdown-css-class="select2-maroon"
                                id="ddlsearchtype"
                                placeholder="Search">
                            <option value="">All</option>
                            <option value="InvoiceNo">Invoice No</option>
                            <option value="CompanyChallanNo">Company ChallanNo</option>
                            <option value="PartyChallanNo">Party ChallanNo</option>
                            <option value="Clear">Clear Invoice</option>
                            <option value="Pending">Pending Invoice</option>
                        </select>
                    </div>
                    <div class="col-12 col-lg-2">
                        <select class="form-control select2 select2-maroon"
                                data-dropdown-css-class="select2-maroon"
                                id="ddlTransactionCompanyName"
                                name="ddlTransactionCompanyName">
                        </select>
                        <input type="hidden" id="txtCompanyname" />
                    </div>
                    <input type="hidden" id="txtuserid" value="@_userSession.UserId" />
                    <div class="col-12 col-lg-2">
                        <select class="form-control select2 select2-maroon" data-dropdown-css-class="select2-maroon" id="ddlInvoicetype">
                            <option value=""></option>
                            <option value="Sales">Sales</option>
                            <option value="Purchase">Purchase</option>
                            <option value="Sales Return">Sales Return</option>
                            <option value="Purchase Return">Purchase Return</option>
                        </select>
                    </div>
                    <div class="col-12 col-lg-2">
                        <select class="form-control select2 select2-maroon"
                                data-dropdown-css-class="select2-maroon"
                                id="ddlPartySearchBy"
                                name="ddlPartySearchBy">
                        </select>
                        <input type="hidden" id="txtpartyname" />
                    </div>
                    <div class="col-12 col-lg-1">
                        <button class="btn  button-bg-maroon" id="toggleDateFilter">
                            <i class="fa fa-calendar" aria-hidden="true"></i><span class="d-none d-sm-inline" style="margin-left: 10px;">Date</span>
                        </button>
                        <div id="dateFilterContainer" class="date-filter-container" style="display: none;">
                            <div class="p-2 bg-light border">
                                <label for="fromDate">From Date</label>
                                <input type="text" id="fromDate" class="form-control mb-3 datepicker" style="font-size: 15px;">
                                <label for="toDate">To Date</label>
                                <input type="text" id="toDate" class="form-control mb-3 datepicker" style="font-size: 15px;">
                                <label for="InvoiceYearDropdown">Year</label>
                                <select id="InvoiceYearDropdown" class="form-control mb-3 select2 select2-maroon "
                                        data-dropdown-css-class="select2-maroon">
                                </select>
                                <button class="btn button-bg-maroon btn-block" id="applyFilters" style="margin-top: 10px;">Apply</button>
                                <button class="btn btn-secondary btn-block" id="resetInvoiceDateFilters">Reset</button>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="card-body p-0">
                <div class="card-body">
                    <div class="table-responsive table-card text-center">
                        <table class="table table-bordered dt-responsive nowrap table-striped align-middle" id="AllVendorCreditDebitList">
                            <thead class="button-teal text-center">
                                <tr>
                                    <th></th>
                                    <th>Vendor Name</th>
                                    <th>Date</th>
                                    <th>Payment Type</th>
                                    <th>Credit Amount</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody class="list form-check-all" id="AllTransactionPartial">
                            </tbody>
                        </table>
                        <!--end table-->
                        <div class="noresult" style="display: none">
                            <div class="text-center">
                                <lord-icon src="https://cdn.lordicon.com/msoeawqm.json" trigger="loop" colors="primary:#25a0e2,secondary:#00bd9d" style="width:75px;height:75px">
                                </lord-icon>
                                <h5 class="mt-2">Sorry! No Result Found</h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!--end card-->
    </div>
    <!--end col-->
</div>

<script type="text/javascript">
    var userPermissions = '@Html.Raw(Json.Serialize(UserSession.FormPermisionData))';
</script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/moduls/creditdebitmasterscript.js" asp-append-version="true"></script>