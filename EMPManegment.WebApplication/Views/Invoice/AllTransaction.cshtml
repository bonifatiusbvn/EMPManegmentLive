@using EMPManegment.Web.Models;
@inject IHttpContextAccessor Accessor;
@inject UserSession _userSession

@{
    ViewData["Title"] = "GetAllTransaction";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}
<link href="~/assets/css/icons.min.css" rel="stylesheet" type="text/css" />

<div class="row" style="margin-top:80px;">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between content-header">
            <h4 class="fm-header mb-sm-0">Transactions List</h4>

            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Payment Transactions</a></li>
                    <li class="breadcrumb-item active">GetAllTransction</li>
                </ol>
            </div>

        </div>
    </div>
</div>
<!-- end page title -->
<div class="row" id="contactList">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <div class="row">
                    <div class="col-12 col-lg-2">
                        <input class="form-control"
                               id="txttransactionSearch"
                               placeholder="Search" />
                    </div>
                    <div class="col-12 col-lg-2">
                        <select class="form-control select2 select2-maroon"
                                data-dropdown-css-class="select2-maroon"
                                id="ddlpaymentType"
                                placeholder="Search">
                            <option value="">All</option>
                            <option value="1">Paid</option>
                            <option value="7">Unpaid</option>
                            <option value="8">Other</option>
                        </select>
                    </div>
                    <div class="col-12 col-lg-2">
                        <select class="form-control select2 select2-teal"
                                data-dropdown-css-class="select2-teal"
                                id="ddlCDCompanyName"
                                name="ddlCDCompanyName">
                        </select>
                        <input type="hidden" id="txtCompanyname" />
                    </div>
                    <input type="hidden" id="txtuserid" value="@_userSession.UserId" />
                    <div class="col-12 col-lg-2">
                        <select class="form-control select2 select2-teal"
                                data-dropdown-css-class="select2-teal"
                                id="ddlCDVendorName"
                                name="ddlCDVendorName">
                        </select>
                        <input type="hidden" id="txtpartyname" />
                    </div>
                    <div class="col-12 col-lg-1">
                        <button class="btn button-teal" id="toggleDateFilter">
                            <i class="fa fa-calendar" aria-hidden="true"></i><span class="d-none d-sm-inline" style="margin-left: 10px;">Date</span>
                        </button>
                        <div id="dateFilterContainer" class="date-filter-container" style="display: none;">
                            <div class="p-2 bg-light border">
                                <label for="txtstartdatebox">From Date</label>
                                <input type="date" id="txtstartdatebox" class="form-control mb-3" style="font-size: 15px;">
                                <label for="txtenddatebox">To Date</label>
                                <input type="date" id="txtenddatebox" class="form-control mb-3" style="font-size: 15px;">
                                <button class="btn button-teal btn-block" id="applyFilters">Apply</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-2">
                        <button class="btn button-rest" style="margin-left: -30px;" onclick="ResetPurchaseOrderData()"> Reset</button>
                    </div>

                </div>
            </div>

            <div class="card-body">
                <div id="vendorAllTransaction" class="ag-theme-teal" style="height: 600px; width: 100%;"></div>
            </div>


        </div>
        <!--end card-->
    </div>
    <!--end col-->
</div>

<script type="text/javascript">
    window.userFormPermissions = @Html.Raw(Json.Serialize(UserSession.FormPermisionData));
</script>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.js"></script>
<script src="~/moduls/creditdebitmasterscript.js" asp-append-version="true"></script>