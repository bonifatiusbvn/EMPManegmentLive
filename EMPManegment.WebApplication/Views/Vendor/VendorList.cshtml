@using EMPManegment.Web.Models
@inject IHttpContextAccessor Accessor;
@inject UserSession _userSession

@{
    ViewData["Title"] = "VendorList";
    Layout = "~/Views/Shared/_HomeLayout.cshtml";
}

<style>

    .CreateVendorButton {
        margin-left: 665px;
    }

    @@media (max-width: 912px) {
        .CreateVendorButton {
            margin-left: 65px;
        }
    }

    .ag-theme-teal .ag-header {
        background-color: #16989A;
        color: white;
    }
</style>
<!-- start page title -->
<div class="row" style="margin-top:80px;">
    <div class="col-12">
        <div class="page-title-box d-sm-flex align-items-center justify-content-between">
            <h4 class="mb-sm-0">Vendor List</h4>

            <div class="page-title-right">
                <ol class="breadcrumb m-0">
                    <li class="breadcrumb-item"><a href="javascript: void(0);">Vendor</a></li>
                    <li class="breadcrumb-item active">Vendor List</li>
                </ol>
            </div>

        </div>
    </div>
</div>
<!-- end page title -->
<div class="row">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col-12 col-md-6 col-lg-4 mb-2 mb-md-0">
                        <input type="text"
                               class="form-control"
                               id="txtVendorSearch"
                               placeholder="Search..."
                               aria-label="Search Vendor" />
                    </div>

                    @if (UserSession.FormPermisionData.Any(a => a.FormName == "Vendor List" && a.Add))
                    {
                        <div class="col-12 col-md-6 col-lg-8 text-md-end mt-2 mt-md-0">
                            <a href="/Vendor/CreateVendor"
                               class="btn btn-info btn-md CreateVendorButton">
                                <i class="ri-add-fill me-1 align-bottom"></i> Add Vendor
                            </a>
                        </div>
                    }
                </div>
            </div>

            <div class="card-body">
                <div id="VendorTable" class="ag-theme-teal" style="height: 600px; width: 100%;"></div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    window.userFormPermissions = @Html.Raw(Json.Serialize(UserSession.FormPermisionData));
</script>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/moduls/vendordetailsscript.js" asp-append-version="true"></script>
